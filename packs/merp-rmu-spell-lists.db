 item","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Quotidien X","description":"Crée un objet à usage quotidien utilisant des sorts jusqu’au niveau 10."},"en":{"name":"Daily X","description":"Creates a daily item using spells through 10th level."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Herutano","name":"Constant","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.Constant.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.Constant.description","level":50,"description":"As Daily X, but appropriate imbedded effects may operate constantly, subject to GM approval.","aoe":"1 item","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Constant","description":"Comme Quotidien X, mais les effets imprégnés appropriés peuvent fonctionner en permanence, sous réserve de l’accord du MJ."},"en":{"name":"Constant","description":"As Daily X, but appropriate imbedded effects may operate constantly, subject to GM approval."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Herutano","name":"Imbed True","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ImbedTrue.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ImbedTrue.description","level":60,"description":"Imbeds one Mentalism or Essence spell of any level in an item; it is normally usable once.","aoe":"1 item","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Imprégnation Véritable","description":"Imprègne dans un objet un sort de Mentalisme ou d’Essence de n’importe quel niveau ; il est normalement utilisable une seule fois."},"en":{"name":"Imbed True","description":"Imbeds one Mentalism or Essence spell of any level in an item; it is normally usable once."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Herutano","name":"Lord Daily","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.LordDaily.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.LordDaily.description","level":75,"description":"Creates exceptionally powerful daily-use items with spells through 20th level; artifact-scale and GM-controlled.","aoe":"1 item","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Quotidien Seigneur","description":"Crée des objets à usage quotidien exceptionnellement puissants, contenant des sorts jusqu’au niveau 20 ; il s’agit d’une magie de niveau artefact placée sous le contrôle du MJ."},"en":{"name":"Lord Daily","description":"Creates exceptionally powerful daily-use items with spells through 20th level; artifact-scale and GM-controlled."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Herutano","name":"Lord Constant","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.LordConstant.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.LordConstant.description","level":90,"description":"As Lord Daily, but appropriate imbedded effects may operate constantly, subject to GM approval.","aoe":"1 item","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Constant Seigneur","description":"Comme Quotidien Seigneur, mais les effets imprégnés appropriés peuvent fonctionner en permanence, sous réserve de l’accord du MJ."},"en":{"name":"Lord Constant","description":"As Lord Daily, but appropriate imbedded effects may operate constantly, subject to GM approval."}}}]},"_id":"heI5AmNROAzsAvhI"}
