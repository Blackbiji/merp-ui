abel":"MERP_RMU.RazakZinul.weaponsmith.spells.SpellParry.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.SpellParry.description","level":30,"description":"Allows one weapon to parry a spell attack as specified by the source rules.","aoe":"1 weapon","duration":"1 parry","range":"self","spellType":"F","localizations":{"fr":{"name":"Parade de Sort","description":"Permet d’utiliser une arme pour parer une attaque de sort selon les modalités précisées par les règles d’origine."},"en":{"name":"Spell Parry","description":"Allows one weapon to parry a spell attack as specified by the source rules."}}},{"spellList":"Weaponsmith","listType":"Base","profession":"Razak-zinul","name":"Weapon V","label":"MERP_RMU.RazakZinul.weaponsmith.spells.WeaponV.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.WeaponV.description","level":50,"description":"The highest weapon enchantment on this list.","aoe":"self","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Arme V","description":"L’enchantement d’arme le plus puissant de cette liste."},"en":{"name":"Weapon V","description":"The highest weapon enchantment on this list."}}}]},"_id":"Nl6RkfywoltHM1MJ"}
{"name":"Far Visions","type":"spell-list","img":"icons/magic/symbols/circled-gem-pink.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"seer-far-visions","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS","sourceBook":"Mentalism Companion","sourceList":"Far Visions","sourcePage":121,"merpRealm":"Mentalism","merpCategory":"Profession","profession":"Seer","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"rmss-spell-list-conversion","reference":"Mentalism Companion p.121; MERP/RMSS Seer p.149"},"compendiumSourceKey":"seer-far-visions","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-mentalism-seer","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Visions Lointaines","system":{"name":"Visions Lointaines","label":"Visions Lointaines","notesLabel":"Visions Lointaines — notes","notes":"<h2>Visions Lointaines</h2><p>Altère et étend les sens du Devin : vision nocturne, perception à distance, observation à travers la matière et sens projetés.</p><p><strong>Conversion MERP-RMU :</strong> liste historique du Devin (Seer), structurée au format RMU tout en conservant ses effets et sa progression d’origine.</p>"}},"en":{"name":"Far Visions","system":{"name":"Far Visions","label":"Far Visions","notesLabel":"Far Visions — notes","notes":"<h2>Far Visions</h2><p>Alters and extends the Seer's senses: night vision, distant perception, observation through matter, and projected senses.</p><p><strong>MERP-RMU Conversion:</strong> historical Seer List, structured in RMU format while preserving its original effects and progression.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Mentalisme","Devin (Base)"],"en":["Mentalism Spell Lists","Seer (Base)"]},"compendiumFolderKeyPath":["spell-lists-mentalism","spell-lists-mentalism-seer"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / Mentalism Companion","name":"Far Visions","listType":"Base","realms":"Mentalism","profession":"Seer","notes":"<h2>Far Visions</h2><p>Alters and extends the Seer's senses: night vision, distant perception, observation through matter, and projected senses.</p><p><strong>MERP-RMU Conversion:</strong> historical Seer List, structured in RMU format while preserving its original effects and progression.</p>","label":"Far Visions","notesLabel":"Far Visions — notes","spells":[{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Watersight","label":"MERP_RMU.Seer.spells.Watersight.name","descriptionLabel":"MERP_RMU.Seer.spells.Watersight.description","level":1,"description":"Permet de voir à travers l’eau jusqu’à 10 pieds par niveau ; une lumière résiduelle reste nécessaire.","aoe":"caster","duration":"10 min/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Vision Aquatique","description":"Permet de voir à travers l’eau jusqu’à 10 pieds par niveau ; une lumière résiduelle reste nécessaire."},"en":{"name":"Watersight","description":"Allows the Seer to see through water up to 10 feet per level; some residual light is still required."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Nightsight","label":"MERP_RMU.Seer.spells.Nightsight.name","descriptionLabel":"MERP_RMU.Seer.spells.Nightsight.description","level":2,"description":"Permet de voir dans l’obscurité normale comme avec une faible lumière.","aoe":"caster","duration":"10 min/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Vision Nocturne","description":"Permet de voir dans l’obscurité normale comme avec une faible lumière."},"en":{"name":"Nightsight","description":"Allows the Seer to see in normal darkness as though in dim light."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Fogsight","label":"MERP_RMU.Seer.spells.Fogsight.name","descriptionLabel":"MERP_RMU.Seer.spells.Fogsight.description","level":3,"description":"Permet de voir normalement à travers brouillard, brume, précipitations et gaz non magiques.","aoe":"caster","duration":"10 min/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Vision à travers le Brouillard","description":"Permet de voir normalement à travers brouillard, brume, précipitations et gaz non magiques."},"en":{"name":"Fogsight","description":"Allows normal sight through non-magical fog, mist, precipitation, and gases."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Woodsight II","label":"MERP_RMU.Seer.spells.WoodsightII.name","descriptionLabel":"MERP_RMU.Seer.spells.WoodsightII.description","level":4,"description":"Permet de voir à travers du bois non magique jusqu’à environ 1 pouce d’épaisseur par niveau.","aoe":"caster","duration":"1 min/lvl (C)","range":"self","spellType":"U","localizations":{"fr":{"name":"Vision à travers le Bois II","description":"Permet de voir à travers du bois non magique jusqu’à environ 1 pouce d’épaisseur par niveau."},"en":{"name":"Woodsight II","description":"Allows the Seer to see through non-magical wood up to about 1 inch of thickness per level."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Long Ear","label":"MERP_RMU.Seer.spells.LongEar.name","descriptionLabel":"MERP_RMU.Seer.spells.LongEar.description","level":5,"description":"Projette le point d’écoute jusqu’à 10 pieds par niveau ; il peut être déplacé à 10 pieds par round tant qu’aucun obstacle infranchissable ne l’arrête.","aoe":"caster","duration":"C","range":"10'/lvl","spellType":"U","localizations":{"fr":{"name":"Ouïe Lointaine","description":"Projette le point d’écoute jusqu’à 10 pieds par niveau ; il peut être déplacé à 10 pieds par round tant qu’aucun obstacle infranchissable ne l’arrête."},"en":{"name":"Long Ear","description":"Projects the point of hearing up to 10 feet per level; it can be moved at 10 feet per round as long as no impassable obstacle blocks it."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Observe I","label":"MERP_RMU.Seer.spells.ObserveI.name","descriptionLabel":"MERP_RMU.Seer.spells.ObserveI.description","level":6,"description":"Crée à courte distance un point d’observation fixe depuis lequel le Devin peut voir et entendre ; le point peut pivoter.","aoe":"caster","duration":"C","range":"10'","spellType":"U","localizations":{"fr":{"name":"Observation I","description":"Crée à courte distance un point d’observation fixe depuis lequel le Devin peut voir et entendre ; le point peut pivoter."},"en":{"name":"Observe I","description":"Creates a fixed observation point at short range from which the Seer can see and hear; the point can rotate."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Long Eye","label":"MERP_RMU.Seer.spells.LongEye.name","descriptionLabel":"MERP_RMU.Seer.spells.LongEye.description","level":7,"description":"Projette le point de vue jusqu’à 10 pieds par niveau ; il peut être déplacé à 10 pieds par round.","aoe":"caster","duration":"C","range":"10'/lvl","spellType":"U","localizations":{"fr":{"name":"Vue Lointaine","description":"Projette le point de vue jusqu’à 10 pieds par niveau ; il peut être déplacé à 10 pieds par round."},"en":{"name":"Long Eye","description":"Projects the viewpoint up to 10 feet per level; it can be moved at 10 feet per round."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Invisiblesight","label":"MERP_RMU.Seer.spells.Invisiblesight.name","descriptionLabel":"MERP_RMU.Seer.spells.Invisiblesight.description","level":8,"description":"Les êtres et objets invisibles apparaissent visibles au Devin ; le sort ne les détecte pas s’il ne regarde pas dans leur direction.","aoe":"caster","duration":"10 min/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Vision de l’Invisible","description":"Les êtres et objets invisibles apparaissent visibles au Devin ; le sort ne les détecte pas s’il ne regarde pas dans leur direction."},"en":{"name":"Invisiblesight","description":"Invisible beings and objects appear visible to the Seer; the spell does not detect them unless the Seer is looking in their direction."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Stonesight II","label":"MERP_RMU.Seer.spells.StonesightII.name","descriptionLabel":"MERP_RMU.Seer.spells.StonesightII.description","level":9,"description":"Comme Woodsight, mais à travers de la pierre non magique.","aoe":"caster","duration":"1 min/lvl (C)","range":"self","spellType":"U","localizations":{"fr":{"name":"Vision à travers la Pierre II","description":"Comme Woodsight, mais à travers de la pierre non magique."},"en":{"name":"Stonesight II","description":"As Woodsight, but through non-magical stone."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Ironsight II","label":"MERP_RMU.Seer.spells.IronsightII.name","descriptionLabel":"MERP_RMU.Seer.spells.IronsightII.description","level":10,"description":"Permet de voir à travers du fer ou de l’acier non magique.","aoe":"caster","duration":"1 min/lvl (C)","range":"self","spellType":"U","localizations":{"fr":{"name":"Vision à travers le Fer II","description":"Permet de voir à travers du fer ou de l’acier non magique."},"en":{"name":"Ironsight II","description":"Allows the Seer to see through non-magical iron or steel."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Illusionsight II","label":"MERP_RMU.Seer.spells.IllusionsightII.name","descriptionLabel":"MERP_RMU.Seer.spells.IllusionsightII.description","level":11,"description":"Permet au Devin de voir au travers des illusions visuelles, phantasmes et glamours qui l’affecteraient normalement.","aoe":"caster","duration":"10 min/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Vision à travers les Illusions II","description":"Permet au Devin de voir au travers des illusions visuelles, phantasmes et glamours qui l’affecteraient normalement."},"en":{"name":"Illusionsight II","description":"Allows the Seer to see through visual illusions, phantasms, and glamours that would otherwise affect them."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Observe II","label":"MERP_RMU.Seer.spells.ObserveII.name","descriptionLabel":"MERP_RMU.Seer.spells.ObserveII.description","level":12,"description":"Comme Observe I, mais avec une portée accrue.","aoe":"caster","duration":"C","range":"10'/lvl","spellType":"U","localizations":{"fr":{"name":"Observation II","description":"Comme Observe I, mais avec une portée accrue."},"en":{"name":"Observe II","description":"As Observe I, but with increased range."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Long Sense","label":"MERP_RMU.Seer.spells.LongSense.name","descriptionLabel":"MERP_RMU.Seer.spells.LongSense.description","level":13,"description":"Projette un ou plusieurs sens du Devin jusqu’à 100 pieds par niveau.","aoe":"caster","duration":"C","range":"100'/lvl","spellType":"U","localizations":{"fr":{"name":"Sens Lointain","description":"Projette un ou plusieurs sens du Devin jusqu’à 100 pieds par niveau."},"en":{"name":"Long Sense","description":"Projects one or more of the Seer’s senses up to 100 feet per level."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Metalsight II","label":"MERP_RMU.Seer.spells.MetalsightII.name","descriptionLabel":"MERP_RMU.Seer.spells.MetalsightII.description","level":14,"description":"Permet de voir à travers n’importe quel métal non magique.","aoe":"caster","duration":"1 min/lvl (C)","range":"self","spellType":"U","localizations":{"fr":{"name":"Vision à travers les Métaux II","description":"Permet de voir à travers n’importe quel métal non magique."},"en":{"name":"Metalsight II","description":"Allows the Seer to see through any non-magical metal."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Utterdarksight","label":"MERP_RMU.Seer.spells.Utterdarksight.name","descriptionLabel":"MERP_RMU.Seer.spells.Utterdarksight.description","level":15,"description":"Permet de voir même dans l’obscurité totale ou magique.","aoe":"caster","duration":"10 min/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Vision dans les Ténèbres Totales","description":"Permet de voir même dans l’obscurité totale ou magique."},"en":{"name":"Utterdarksight","description":"Allows the Seer to see even in total or magical darkness."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Greater Observe","label":"MERP_RMU.Seer.spells.GreaterObserve.name","descriptionLabel":"MERP_RMU.Seer.spells.GreaterObserve.description","level":16,"description":"Permet d’observer simultanément deux points distincts situés à portée.","aoe":"caster","duration":"C","range":"100'","spellType":"U","localizations":{"fr":{"name":"Observation Supérieure","description":"Permet d’observer simultanément deux points distincts situés à portée."},"en":{"name":"Greater Observe","description":"Allows simultaneous observation of two distinct points within range."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Observe III","label":"MERP_RMU.Seer.spells.ObserveIII.name","descriptionLabel":"MERP_RMU.Seer.spells.ObserveIII.description","level":17,"description":"Comme Observe I avec une portée considérablement accrue.","aoe":"caster","duration":"C","range":"100'/lvl","spellType":"U","localizations":{"fr":{"name":"Observation III","description":"Comme Observe I avec une portée considérablement accrue."},"en":{"name":"Observe III","description":"As Observe I, but with greatly increased range."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Wallsight","label":"MERP_RMU.Seer.spells.Wallsight.name","descriptionLabel":"MERP_RMU.Seer.spells.Wallsight.description","level":18,"description":"Permet de voir à travers une paroi non magique, quelle que soit son épaisseur pratique.","aoe":"caster","duration":"1 min/lvl (C)","range":"self","spellType":"U","localizations":{"fr":{"name":"Vision à travers les Murs","description":"Permet de voir à travers une paroi non magique, quelle que soit son épaisseur pratique."},"en":{"name":"Wallsight","description":"Allows the Seer to see through a non-magical wall regardless of its practical thickness."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Waiting Observe","label":"MERP_RMU.Seer.spells.WaitingObserve.name","descriptionLabel":"MERP_RMU.Seer.spells.WaitingObserve.description","level":19,"description":"Place un Observe III en attente, déclenché par un mouvement ou un son perceptible ; le Devin peut alors concentrer ses sens sur le point préparé.","aoe":"caster","duration":"1 day/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Observation en Attente","description":"Place un Observe III en attente, déclenché par un mouvement ou un son perceptible ; le Devin peut alors concentrer ses sens sur le point préparé."},"en":{"name":"Waiting Observe","description":"Places an Observe III effect in waiting, triggered by perceptible movement or sound; the Seer may then focus their senses on the prepared point."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Greater Long Sense","label":"MERP_RMU.Seer.spells.GreaterLongSense.name","descriptionLabel":"MERP_RMU.Seer.spells.GreaterLongSense.description","level":20,"description":"Comme Long Sense, avec une portée d’un mile par niveau.","aoe":"caster","duration":"C","range":"1 mile/lvl","spellType":"U","localizations":{"fr":{"name":"Sens Lointain Supérieur","description":"Comme Long Sense, avec une portée d’un mile par niveau."},"en":{"name":"Greater Long Sense","description":"As Long Sense, but with a range of one mile per level."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Observe True","label":"MERP_RMU.Seer.spells.ObserveTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.ObserveTrue.description","level":25,"description":"Comme Observe III, mais l’observation peut être maintenue pendant 1 minute par niveau sans concentration continue ; une perception détaillée n’est possible qu’à intervalles réguliers.","aoe":"caster","duration":"1 min/lvl","range":"100'/lvl","spellType":"U","localizations":{"fr":{"name":"Observation Véritable","description":"Comme Observe III, mais l’observation peut être maintenue pendant 1 minute par niveau sans concentration continue ; une perception détaillée n’est possible qu’à intervalles réguliers."},"en":{"name":"Observe True","description":"As Observe III, but the observation can be maintained for 1 minute per level without continuous concentration; detailed perception is possible only at regular intervals."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Sight True","label":"MERP_RMU.Seer.spells.SightTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.SightTrue.description","level":30,"description":"Permet de voir à travers toute matière inanimée ; les matériaux fortement magiques peuvent résister.","aoe":"caster","duration":"1 min/lvl (C)","range":"self","spellType":"U","localizations":{"fr":{"name":"Vision Véritable","description":"Permet de voir à travers toute matière inanimée ; les matériaux fortement magiques peuvent résister."},"en":{"name":"Sight True","description":"Allows the Seer to see through any inanimate matter; strongly magical materials may resist."}}},{"spellList":"Far Visions","listType":"Base","profession":"Seer","name":"Long Sense True","label":"MERP_RMU.Seer.spells.LongSenseTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.LongSenseTrue.description","level":50,"description":"Projette les sens du Devin à une distance pratiquement illimitée.","aoe":"caster","duration":"C","range":"unlimited","spellType":"U","localizations":{"fr":{"name":"Sens Lointain Véritable","description":"Projette les sens du Devin à une distance pratiquement illimitée."},"en":{"name":"Long Sense True","description":"Projects the Seer’s senses to a practically unlimited distance."}}}]},"_id":"BZQZWUJDtGoJpfOf"}
{"name":"Future Visions","type":"spell-list","img":"icons/magic/symbols/circled-gem-pink.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"seer-future-visions","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS","sourceBook":"Mentalism Companion","sourceList":"Future Visions","sourcePage":122,"merpRealm":"Mentalism","merpCategory":"Profession","profession":"Seer","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"rmss-spell-list-conversion","reference":"Mentalism Companion p.122; MERP/RMSS Seer p.149"},"compendiumSourceKey":"seer-future-visions","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-mentalism-seer","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Visions du Futur","system":{"name":"Visions du Futur","label":"Visions du Futur","notesLabel":"Visions du Futur — notes","notes":"<h2>Visions du Futur</h2><p>Précognition, rêves prophétiques, divinations et anticipation des actions ou des sorts.</p><p><strong>Conversion MERP-RMU :</strong> liste historique du Devin (Seer), structurée au format RMU tout en conservant ses effets et sa progression d’origine.</p>"}},"en":{"name":"Future Visions","system":{"name":"Future Visions","label":"Future Visions","notesLabel":"Future Visions — notes","notes":"<h2>Future Visions</h2><p>Precognition, prophetic dreams, divinations, and anticipation of actions or spells.</p><p><strong>MERP-RMU Conversion:</strong> historical Seer List, structured in RMU format while preserving its original effects and progression.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Mentalisme","Devin (Base)"],"en":["Mentalism Spell Lists","Seer (Base)"]},"compendiumFolderKeyPath":["spell-lists-mentalism","spell-lists-mentalism-seer"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / Mentalism Companion","name":"Future Visions","listType":"Base","realms":"Mentalism","profession":"Seer","notes":"<h2>Future Visions</h2><p>Precognition, prophetic dreams, divinations, and anticipation of actions or spells.</p><p><strong>MERP-RMU Conversion:</strong> historical Seer List, structured in RMU format while preserving its original effects and progression.</p>","label":"Future Visions","notesLabel":"Future Visions — notes","spells":[{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Intuitions I","label":"MERP_RMU.Seer.spells.IntuitionsI.name","descriptionLabel":"MERP_RMU.Seer.spells.IntuitionsI.description","level":1,"description":"Montre ce qui se produira probablement durant la prochaine minute si le Devin entreprend une action précise.","aoe":"caster","duration":"—","range":"self","spellType":"I","localizations":{"fr":{"name":"Intuitions I","description":"Montre ce qui se produira probablement durant la prochaine minute si le Devin entreprend une action précise."},"en":{"name":"Intuitions I","description":"Shows what will probably happen during the next minute if the Seer undertakes one specified action."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Detect Destiny","label":"MERP_RMU.Seer.spells.DetectDestiny.name","descriptionLabel":"MERP_RMU.Seer.spells.DetectDestiny.description","level":2,"description":"Détecte l’existence d’un destin, d’un wyrd ou d’une destinée encore inaccomplie attachée à une personne, un objet ou un lieu.","aoe":"varies","duration":"—","range":"touch","spellType":"P","localizations":{"fr":{"name":"Détection du Destin","description":"Détecte l’existence d’un destin, d’un wyrd ou d’une destinée encore inaccomplie attachée à une personne, un objet ou un lieu."},"en":{"name":"Detect Destiny","description":"Detects the existence of a destiny, wyrd, or as-yet-unfulfilled fate attached to a person, object, or place."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Intuitions III","label":"MERP_RMU.Seer.spells.IntuitionsIII.name","descriptionLabel":"MERP_RMU.Seer.spells.IntuitionsIII.description","level":3,"description":"Comme Intuitions I, mais la vision porte jusqu’à trois minutes dans le futur.","aoe":"caster","duration":"—","range":"self","spellType":"I","localizations":{"fr":{"name":"Intuitions III","description":"Comme Intuitions I, mais la vision porte jusqu’à trois minutes dans le futur."},"en":{"name":"Intuitions III","description":"As Intuitions I, but the vision extends up to three minutes into the future."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Anticipate Attack","label":"MERP_RMU.Seer.spells.AnticipateAttack.name","descriptionLabel":"MERP_RMU.Seer.spells.AnticipateAttack.description","level":4,"description":"Permet d’anticiper une attaque imminente : le Devin gagne +50 DB contre une attaque de mêlée, de projectile ou élémentaire dirigée ; les autres attaques magiques peuvent subir un malus approprié.","aoe":"1 attack","duration":"—","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Anticipation d’Attaque","description":"Permet d’anticiper une attaque imminente : le Devin gagne +50 DB contre une attaque de mêlée, de projectile ou élémentaire dirigée ; les autres attaques magiques peuvent subir un malus approprié."},"en":{"name":"Anticipate Attack","description":"Allows the Seer to anticipate an imminent attack: the Seer gains +50 DB against one incoming melee, missile, or elemental attack; other magical attacks may suffer an appropriate penalty."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Intuitions V","label":"MERP_RMU.Seer.spells.IntuitionsV.name","descriptionLabel":"MERP_RMU.Seer.spells.IntuitionsV.description","level":5,"description":"Comme Intuitions I, mais jusqu’à cinq minutes dans le futur.","aoe":"caster","duration":"—","range":"self","spellType":"I","localizations":{"fr":{"name":"Intuitions V","description":"Comme Intuitions I, mais jusqu’à cinq minutes dans le futur."},"en":{"name":"Intuitions V","description":"As Intuitions I, but up to five minutes into the future."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Dream I","label":"MERP_RMU.Seer.spells.DreamI.name","descriptionLabel":"MERP_RMU.Seer.spells.DreamI.description","level":6,"description":"Après avoir choisi un sujet avant de dormir, le Devin reçoit un rêve symbolique ou informatif à son propos ; une fois par nuit.","aoe":"caster","duration":"sleep","range":"self","spellType":"I","localizations":{"fr":{"name":"Rêve I","description":"Après avoir choisi un sujet avant de dormir, le Devin reçoit un rêve symbolique ou informatif à son propos ; une fois par nuit."},"en":{"name":"Dream I","description":"After choosing a subject before sleeping, the Seer receives a symbolic or informative dream about it; once per night."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Anticipations I","label":"MERP_RMU.Seer.spells.AnticipationsI.name","descriptionLabel":"MERP_RMU.Seer.spells.AnticipationsI.description","level":7,"description":"Prédit l’action la plus probable d’un être au round suivant, permettant au Devin de réagir après avoir appris cette intention.","aoe":"caster","duration":"—","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Anticipations I","description":"Prédit l’action la plus probable d’un être au round suivant, permettant au Devin de réagir après avoir appris cette intention."},"en":{"name":"Anticipations I","description":"Predicts the most likely action of one being in the next round, allowing the Seer to react after learning that intention."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Divinations I","label":"MERP_RMU.Seer.spells.DivinationsI.name","descriptionLabel":"MERP_RMU.Seer.spells.DivinationsI.description","level":8,"description":"À l’aide d’un support divinatoire culturellement approprié, obtient une prédiction sur une personne, un lieu ou un objet ; la lecture prend une minute par niveau du sort et porte au plus sur un jour par niveau.","aoe":"caster","duration":"1 reading","range":"self","spellType":"I","localizations":{"fr":{"name":"Divinations I","description":"À l’aide d’un support divinatoire culturellement approprié, obtient une prédiction sur une personne, un lieu ou un objet ; la lecture prend une minute par niveau du sort et porte au plus sur un jour par niveau."},"en":{"name":"Divinations I","description":"Using a culturally appropriate divinatory medium, obtains a prediction about a person, place, or object; the reading takes one minute per spell level and reaches no farther than one day per level into the future."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Spell Anticipations I","label":"MERP_RMU.Seer.spells.SpellAnticipationsI.name","descriptionLabel":"MERP_RMU.Seer.spells.SpellAnticipationsI.description","level":9,"description":"Comme Anticipations I ; si l’action prévue est un sort, le Devin en apprend le sort exact et la cible probable.","aoe":"caster","duration":"—","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Anticipations de Sort I","description":"Comme Anticipations I ; si l’action prévue est un sort, le Devin en apprend le sort exact et la cible probable."},"en":{"name":"Spell Anticipations I","description":"As Anticipations I; if the predicted action is a spell, the Seer learns the exact spell and its likely target."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Intuitions X","label":"MERP_RMU.Seer.spells.IntuitionsX.name","descriptionLabel":"MERP_RMU.Seer.spells.IntuitionsX.description","level":10,"description":"Comme Intuitions I, mais jusqu’à dix minutes dans le futur.","aoe":"caster","duration":"—","range":"self","spellType":"I","localizations":{"fr":{"name":"Intuitions X","description":"Comme Intuitions I, mais jusqu’à dix minutes dans le futur."},"en":{"name":"Intuitions X","description":"As Intuitions I, but up to ten minutes into the future."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Dream II","label":"MERP_RMU.Seer.spells.DreamII.name","descriptionLabel":"MERP_RMU.Seer.spells.DreamII.description","level":11,"description":"Comme Dream I, mais permet deux rêves par nuit sur des sujets différents.","aoe":"caster","duration":"1 sleep","range":"self","spellType":"I","localizations":{"fr":{"name":"Rêve II","description":"Comme Dream I, mais permet deux rêves par nuit sur des sujets différents."},"en":{"name":"Dream II","description":"As Dream I, but allows two dreams per night on different subjects."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Divinations II","label":"MERP_RMU.Seer.spells.DivinationsII.name","descriptionLabel":"MERP_RMU.Seer.spells.DivinationsII.description","level":12,"description":"Comme Divinations I, mais peut porter jusqu’à un mois par niveau dans le futur.","aoe":"caster","duration":"1 reading","range":"self","spellType":"I","localizations":{"fr":{"name":"Divinations II","description":"Comme Divinations I, mais peut porter jusqu’à un mois par niveau dans le futur."},"en":{"name":"Divinations II","description":"As Divinations I, but may reach up to one month per level into the future."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Anticipations III","label":"MERP_RMU.Seer.spells.AnticipationsIII.name","descriptionLabel":"MERP_RMU.Seer.spells.AnticipationsIII.description","level":13,"description":"Permet de prévoir les actions de trois êtres au prochain round ou d’un seul être pendant trois rounds.","aoe":"caster","duration":"—","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Anticipations III","description":"Permet de prévoir les actions de trois êtres au prochain round ou d’un seul être pendant trois rounds."},"en":{"name":"Anticipations III","description":"Allows the Seer to predict the actions of three beings in the next round or one being for three rounds."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Destiny Analysis","label":"MERP_RMU.Seer.spells.DestinyAnalysis.name","descriptionLabel":"MERP_RMU.Seer.spells.DestinyAnalysis.description","level":14,"description":"Analyse une destinée détectée : son origine, sa force et sa formulation symbolique ; peut révéler une fausse prophétie mais pas nécessairement comment l’accomplir.","aoe":"varies","duration":"—","range":"self","spellType":"P","localizations":{"fr":{"name":"Analyse du Destin","description":"Analyse une destinée détectée : son origine, sa force et sa formulation symbolique ; peut révéler une fausse prophétie mais pas nécessairement comment l’accomplir."},"en":{"name":"Destiny Analysis","description":"Analyzes a detected destiny: its origin, strength, and symbolic wording; it may expose a false prophecy but does not necessarily reveal how the destiny can be fulfilled."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Intuitions True","label":"MERP_RMU.Seer.spells.IntuitionsTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.IntuitionsTrue.description","level":15,"description":"Comme Intuitions I, mais la profondeur de vision atteint une minute par niveau.","aoe":"caster","duration":"—","range":"self","spellType":"I","localizations":{"fr":{"name":"Intuitions Véritables","description":"Comme Intuitions I, mais la profondeur de vision atteint une minute par niveau."},"en":{"name":"Intuitions True","description":"As Intuitions I, but the depth of vision reaches one minute per level."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Dream III","label":"MERP_RMU.Seer.spells.DreamIII.name","descriptionLabel":"MERP_RMU.Seer.spells.DreamIII.description","level":16,"description":"Comme Dream I, mais permet trois rêves par nuit.","aoe":"caster","duration":"1 sleep","range":"self","spellType":"I","localizations":{"fr":{"name":"Rêve III","description":"Comme Dream I, mais permet trois rêves par nuit."},"en":{"name":"Dream III","description":"As Dream I, but allows three dreams per night."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Divinations III","label":"MERP_RMU.Seer.spells.DivinationsIII.name","descriptionLabel":"MERP_RMU.Seer.spells.DivinationsIII.description","level":17,"description":"Comme Divinations I, mais peut porter jusqu’à un an par niveau dans le futur.","aoe":"caster","duration":"1 reading","range":"self","spellType":"I","localizations":{"fr":{"name":"Divinations III","description":"Comme Divinations I, mais peut porter jusqu’à un an par niveau dans le futur."},"en":{"name":"Divinations III","description":"As Divinations I, but may reach up to one year per level into the future."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Spell Anticipations III","label":"MERP_RMU.Seer.spells.SpellAnticipationsIII.name","descriptionLabel":"MERP_RMU.Seer.spells.SpellAnticipationsIII.description","level":18,"description":"Comme Anticipations III, avec identification des sorts et de leurs cibles probables.","aoe":"caster","duration":"—","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Anticipations de Sort III","description":"Comme Anticipations III, avec identification des sorts et de leurs cibles probables."},"en":{"name":"Spell Anticipations III","description":"As Anticipations III, with identification of spells and their likely targets."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Anticipations V","label":"MERP_RMU.Seer.spells.AnticipationsV.name","descriptionLabel":"MERP_RMU.Seer.spells.AnticipationsV.description","level":19,"description":"Prédit les actions de cinq êtres au prochain round ou d’un seul être pendant cinq rounds.","aoe":"caster","duration":"—","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Anticipations V","description":"Prédit les actions de cinq êtres au prochain round ou d’un seul être pendant cinq rounds."},"en":{"name":"Anticipations V","description":"Predicts the actions of five beings in the next round or one being for five rounds."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Lord Dream","label":"MERP_RMU.Seer.spells.LordDream.name","descriptionLabel":"MERP_RMU.Seer.spells.LordDream.description","level":20,"description":"Comme Dream I, mais permet jusqu’à cinq rêves par nuit.","aoe":"caster","duration":"sleep","range":"self","spellType":"I","localizations":{"fr":{"name":"Rêve Seigneur","description":"Comme Dream I, mais permet jusqu’à cinq rêves par nuit."},"en":{"name":"Lord Dream","description":"As Dream I, but allows up to five dreams per night."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Anticipations True","label":"MERP_RMU.Seer.spells.AnticipationsTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.AnticipationsTrue.description","level":25,"description":"Prédit les actions probables de tous les êtres situés dans un rayon de 100 pieds.","aoe":"caster","duration":"—","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Anticipations Véritables","description":"Prédit les actions probables de tous les êtres situés dans un rayon de 100 pieds."},"en":{"name":"Anticipations True","description":"Predicts the likely actions of all beings within a 100-foot radius."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Spell Anticipations True","label":"MERP_RMU.Seer.spells.SpellAnticipationsTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.SpellAnticipationsTrue.description","level":30,"description":"Comme Anticipations True, avec identification des sorts et de leurs cibles probables.","aoe":"caster","duration":"—","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Anticipations de Sort Véritables","description":"Comme Anticipations True, avec identification des sorts et de leurs cibles probables."},"en":{"name":"Spell Anticipations True","description":"As Anticipations True, with identification of spells and their likely targets."}}},{"spellList":"Future Visions","listType":"Base","profession":"Seer","name":"Divinations True","label":"MERP_RMU.Seer.spells.DivinationsTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.DivinationsTrue.description","level":50,"description":"Comme Divinations I, mais la lecture peut porter jusqu’à dix ans par niveau dans le futur.","aoe":"caster","duration":"1 reading","range":"self","spellType":"I","localizations":{"fr":{"name":"Divinations Véritables","description":"Comme Divinations I, mais la lecture peut porter jusqu’à dix ans par niveau dans le futur."},"en":{"name":"Divinations True","description":"As Divinations I, but the reading may reach up to ten years per level into the future."}}}]},"_id":"qR8KdyjWs1W2jDW3"}
{"name":"Mind Visions","type":"spell-list","img":"icons/magic/symbols/circled-gem-pink.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"seer-mind-visions","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS","sourceBook":"Mentalism Companion","sourceList":"Mind Visions","sourcePage":123,"merpRealm":"Mentalism","merpCategory":"Profession","profession":"Seer","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"rmss-spell-list-conversion","reference":"Mentalism Companion p.123; MERP/RMSS Seer p.149"},"compendiumSourceKey":"seer-mind-visions","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-mentalism-seer","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Visions de l'Esprit","system":{"name":"Visions de l'Esprit","label":"Visions de l'Esprit","notesLabel":"Visions de l'Esprit — notes","notes":"<h2>Visions de l'Esprit</h2><p>Détection des esprits, lecture mentale, recherche d’individus, vérité et exploration des souvenirs.</p><p><strong>Conversion MERP-RMU :</strong> liste historique du Devin (Seer), structurée au format RMU tout en conservant ses effets et sa progression d’origine.</p>"}},"en":{"name":"Mind Visions","system":{"name":"Mind Visions","label":"Mind Visions","notesLabel":"Mind Visions — notes","notes":"<h2>Mind Visions</h2><p>Detection of minds, mind reading, searching for individuals, truth, and exploration of memories.</p><p><strong>MERP-RMU Conversion:</strong> historical Seer List, structured in RMU format while preserving its original effects and progression.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Mentalisme","Devin (Base)"],"en":["Mentalism Spell Lists","Seer (Base)"]},"compendiumFolderKeyPath":["spell-lists-mentalism","spell-lists-mentalism-seer"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / Mentalism Companion","name":"Mind Visions","listType":"Base","realms":"Mentalism","profession":"Seer","notes":"<h2>Mind Visions</h2><p>Detection of minds, mind reading, searching for individuals, truth, and exploration of memories.</p><p><strong>MERP-RMU Conversion:</strong> historical Seer List, structured in RMU format while preserving its original effects and progression.</p>","label":"Mind Visions","notesLabel":"Mind Visions — notes","spells":[{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Seer's Presence","label":"MERP_RMU.Seer.spells.SeersPresence.name","descriptionLabel":"MERP_RMU.Seer.spells.SeersPresence.description","level":1,"description":"Détecte la présence de tous les êtres pensants dans un rayon de 10 pieds par niveau ; les animaux peuvent être inclus au prix d’un effort supplémentaire.","aoe":"10'R/lvl","duration":"C","range":"self","spellType":"U","localizations":{"fr":{"name":"Présence du Devin","description":"Détecte la présence de tous les êtres pensants dans un rayon de 10 pieds par niveau ; les animaux peuvent être inclus au prix d’un effort supplémentaire."},"en":{"name":"Seer's Presence","description":"Detects the presence of all thinking beings within 10 feet per level; animals may be included at the cost of additional effort."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Mind Store","label":"MERP_RMU.Seer.spells.MindStore.name","descriptionLabel":"MERP_RMU.Seer.spells.MindStore.description","level":2,"description":"Mémorise la signature mentale d’une cible détectée ; le nombre total de signatures conservées dépend des capacités mentales du Devin.","aoe":"1 target","duration":"—","range":"10'/lvl","spellType":"Pm","localizations":{"fr":{"name":"Mémorisation Mentale","description":"Mémorise la signature mentale d’une cible détectée ; le nombre total de signatures conservées dépend des capacités mentales du Devin."},"en":{"name":"Mind Store","description":"Stores the mental signature of a detected target; the total number of signatures retained depends on the Seer’s mental capabilities."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Seer's Analysis","label":"MERP_RMU.Seer.spells.SeersAnalysis.name","descriptionLabel":"MERP_RMU.Seer.spells.SeersAnalysis.description","level":3,"description":"Révèle un renseignement fondamental sur une cible détectée, tel que race, profession ou niveau.","aoe":"1 target","duration":"—","range":"10'/lvl","spellType":"Pm","localizations":{"fr":{"name":"Analyse du Devin","description":"Révèle un renseignement fondamental sur une cible détectée, tel que race, profession ou niveau."},"en":{"name":"Seer's Analysis","description":"Reveals one fundamental piece of information about a detected target, such as race, profession, or level."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Minor Finding","label":"MERP_RMU.Seer.spells.MinorFinding.name","descriptionLabel":"MERP_RMU.Seer.spells.MinorFinding.description","level":4,"description":"Donne direction et distance vers un esprit non protégé dont la signature a été mémorisée.","aoe":"caster","duration":"C","range":"100'/lvl","spellType":"Pm","localizations":{"fr":{"name":"Localisation Mineure","description":"Donne direction et distance vers un esprit non protégé dont la signature a été mémorisée."},"en":{"name":"Minor Finding","description":"Gives direction and distance to an unprotected mind whose signature has been stored."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Thoughts","label":"MERP_RMU.Seer.spells.Thoughts.name","descriptionLabel":"MERP_RMU.Seer.spells.Thoughts.description","level":5,"description":"Lit les pensées de surface d’une cible ; une résistance particulièrement forte peut lui faire remarquer l’intrusion.","aoe":"1 target/rnd","duration":"1 rnd/lvl (C)","range":"100'","spellType":"Fm","localizations":{"fr":{"name":"Pensées","description":"Lit les pensées de surface d’une cible ; une résistance particulièrement forte peut lui faire remarquer l’intrusion."},"en":{"name":"Thoughts","description":"Reads a target’s surface thoughts; particularly strong resistance may alert the target to the intrusion."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Questioning","label":"MERP_RMU.Seer.spells.Questioning.name","descriptionLabel":"MERP_RMU.Seer.spells.Questioning.description","level":6,"description":"Force une cible à fournir mentalement des réponses véridiques à des questions simples, une par round.","aoe":"1 target","duration":"1 rnd/lvl (C)","range":"10'","spellType":"Fm","localizations":{"fr":{"name":"Interrogation","description":"Force une cible à fournir mentalement des réponses véridiques à des questions simples, une par round."},"en":{"name":"Questioning","description":"Forces a target to provide truthful mental answers to simple questions, one per round."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Mind Typing","label":"MERP_RMU.Seer.spells.MindTyping.name","descriptionLabel":"MERP_RMU.Seer.spells.MindTyping.description","level":7,"description":"Comme Seer’s Analysis, mais révèle simultanément race, profession et niveau.","aoe":"1 target","duration":"—","range":"10'/lvl","spellType":"Pm","localizations":{"fr":{"name":"Typage Mental","description":"Comme Seer’s Analysis, mais révèle simultanément race, profession et niveau."},"en":{"name":"Mind Typing","description":"As Seer’s Analysis, but simultaneously reveals race, profession, and level."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Awareness","label":"MERP_RMU.Seer.spells.Awareness.name","descriptionLabel":"MERP_RMU.Seer.spells.Awareness.description","level":8,"description":"Comme Presence, mais donne aussi une idée générale des actions entreprises par les esprits détectés.","aoe":"10'R/lvl","duration":"C","range":"self","spellType":"Pm","localizations":{"fr":{"name":"Conscience","description":"Comme Presence, mais donne aussi une idée générale des actions entreprises par les esprits détectés."},"en":{"name":"Awareness","description":"As Presence, but also gives a general idea of the actions being undertaken by detected minds."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Truth I","label":"MERP_RMU.Seer.spells.TruthI.name","descriptionLabel":"MERP_RMU.Seer.spells.TruthI.description","level":9,"description":"Le Devin sait lorsqu’une personne située dans le rayon ment.","aoe":"10'R","duration":"C","range":"self","spellType":"Pm","localizations":{"fr":{"name":"Vérité I","description":"Le Devin sait lorsqu’une personne située dans le rayon ment."},"en":{"name":"Truth I","description":"The Seer knows when a person within the radius is lying."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Inner Thoughts","label":"MERP_RMU.Seer.spells.InnerThoughts.name","descriptionLabel":"MERP_RMU.Seer.spells.InnerThoughts.description","level":10,"description":"Comme Thoughts, mais permet de comprendre les raisonnements et structures mentales sous-jacentes.","aoe":"1 target/rnd","duration":"1 rnd/lvl (C)","range":"100'","spellType":"Fm","localizations":{"fr":{"name":"Pensées Profondes","description":"Comme Thoughts, mais permet de comprendre les raisonnements et structures mentales sous-jacentes."},"en":{"name":"Inner Thoughts","description":"As Thoughts, but allows understanding of underlying reasoning and mental structures."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Awareness True","label":"MERP_RMU.Seer.spells.AwarenessTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.AwarenessTrue.description","level":11,"description":"Comme Awareness, mais révèle l’ensemble des actions immédiates des cibles pour le round.","aoe":"10'R/lvl","duration":"C","range":"self","spellType":"Pm","localizations":{"fr":{"name":"Conscience Véritable","description":"Comme Awareness, mais révèle l’ensemble des actions immédiates des cibles pour le round."},"en":{"name":"Awareness True","description":"As Awareness, but reveals all immediate actions of the targets for the round."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Long Mind Store","label":"MERP_RMU.Seer.spells.LongMindStore.name","descriptionLabel":"MERP_RMU.Seer.spells.LongMindStore.description","level":12,"description":"Comme Mind Store, avec une portée de 100 pieds par niveau.","aoe":"1 target","duration":"—","range":"100'/lvl","spellType":"Pm","localizations":{"fr":{"name":"Mémorisation Mentale Lointaine","description":"Comme Mind Store, avec une portée de 100 pieds par niveau."},"en":{"name":"Long Mind Store","description":"As Mind Store, but with a range of 100 feet per level."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Long Mind Typing","label":"MERP_RMU.Seer.spells.LongMindTyping.name","descriptionLabel":"MERP_RMU.Seer.spells.LongMindTyping.description","level":13,"description":"Comme Mind Typing, avec une portée de 100 pieds par niveau.","aoe":"1 target","duration":"—","range":"100'/lvl","spellType":"Pm","localizations":{"fr":{"name":"Typage Mental Lointain","description":"Comme Mind Typing, avec une portée de 100 pieds par niveau."},"en":{"name":"Long Mind Typing","description":"As Mind Typing, but with a range of 100 feet per level."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Finding I","label":"MERP_RMU.Seer.spells.FindingI.name","descriptionLabel":"MERP_RMU.Seer.spells.FindingI.description","level":14,"description":"Comme Minor Finding, avec une portée d’un mile par niveau.","aoe":"caster","duration":"C","range":"1 mile/lvl","spellType":"Pm","localizations":{"fr":{"name":"Localisation I","description":"Comme Minor Finding, avec une portée d’un mile par niveau."},"en":{"name":"Finding I","description":"As Minor Finding, but with a range of one mile per level."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Mind Scan","label":"MERP_RMU.Seer.spells.MindScan.name","descriptionLabel":"MERP_RMU.Seer.spells.MindScan.description","level":15,"description":"Comme Inner Thoughts, mais peut explorer les souvenirs conscients, une scène ou séquence à la fois.","aoe":"1 target/rnd","duration":"1 rnd/lvl (C)","range":"100'","spellType":"Fm","localizations":{"fr":{"name":"Exploration Mentale","description":"Comme Inner Thoughts, mais peut explorer les souvenirs conscients, une scène ou séquence à la fois."},"en":{"name":"Mind Scan","description":"As Inner Thoughts, but can explore conscious memories, one scene or sequence at a time."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Truth V","label":"MERP_RMU.Seer.spells.TruthV.name","descriptionLabel":"MERP_RMU.Seer.spells.TruthV.description","level":16,"description":"Comme Truth I, mais dans un rayon de 50 pieds.","aoe":"50'R","duration":"C","range":"self","spellType":"Pm","localizations":{"fr":{"name":"Vérité V","description":"Comme Truth I, mais dans un rayon de 50 pieds."},"en":{"name":"Truth V","description":"As Truth I, but within a 50-foot radius."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Long Truth","label":"MERP_RMU.Seer.spells.LongTruth.name","descriptionLabel":"MERP_RMU.Seer.spells.LongTruth.description","level":17,"description":"Comme Truth I, mais peut être projeté à 10 pieds par niveau.","aoe":"10'R","duration":"C","range":"10'/lvl","spellType":"Pm","localizations":{"fr":{"name":"Vérité Lointaine","description":"Comme Truth I, mais peut être projeté à 10 pieds par niveau."},"en":{"name":"Long Truth","description":"As Truth I, but may be projected to 10 feet per level."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Past Truth","label":"MERP_RMU.Seer.spells.PastTruth.name","descriptionLabel":"MERP_RMU.Seer.spells.PastTruth.description","level":18,"description":"Applique la détection du mensonge à une vision du passé, permettant d’identifier les mensonges prononcés dans celle-ci.","aoe":"1 vision","duration":"varies","range":"self","spellType":"Pm","localizations":{"fr":{"name":"Vérité du Passé","description":"Applique la détection du mensonge à une vision du passé, permettant d’identifier les mensonges prononcés dans celle-ci."},"en":{"name":"Past Truth","description":"Applies lie detection to a vision of the past, allowing lies spoken within it to be identified."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Finding V","label":"MERP_RMU.Seer.spells.FindingV.name","descriptionLabel":"MERP_RMU.Seer.spells.FindingV.description","level":19,"description":"Comme Minor Finding, avec une portée de cinq miles par niveau.","aoe":"caster","duration":"C","range":"5 miles/lvl","spellType":"Pm","localizations":{"fr":{"name":"Localisation V","description":"Comme Minor Finding, avec une portée de cinq miles par niveau."},"en":{"name":"Finding V","description":"As Minor Finding, but with a range of five miles per level."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Mind Probe","label":"MERP_RMU.Seer.spells.MindProbe.name","descriptionLabel":"MERP_RMU.Seer.spells.MindProbe.description","level":20,"description":"Comme Mind Scan, mais atteint aussi les souvenirs subconscients et des expériences profondément enfouies.","aoe":"1 target/rnd","duration":"1 rnd/lvl (C)","range":"100'","spellType":"Fm","localizations":{"fr":{"name":"Sonde Mentale","description":"Comme Mind Scan, mais atteint aussi les souvenirs subconscients et des expériences profondément enfouies."},"en":{"name":"Mind Probe","description":"As Mind Scan, but also reaches subconscious memories and deeply buried experiences."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Thought Steal","label":"MERP_RMU.Seer.spells.ThoughtSteal.name","descriptionLabel":"MERP_RMU.Seer.spells.ThoughtSteal.description","level":25,"description":"Retire de l’esprit d’une cible une pensée ou un souvenir par round pendant la durée.","aoe":"1 target","duration":"1 rnd/lvl (C)","range":"100'","spellType":"Fm","localizations":{"fr":{"name":"Vol de Pensée","description":"Retire de l’esprit d’une cible une pensée ou un souvenir par round pendant la durée."},"en":{"name":"Thought Steal","description":"Removes one thought or memory from a target’s mind per round for the duration."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Truth True","label":"MERP_RMU.Seer.spells.TruthTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.TruthTrue.description","level":30,"description":"Version supérieure de Truth : peut produire soit un vaste champ de vérité, soit une détection de vérité à très grande distance selon l’usage choisi.","aoe":"varies","duration":"varies","range":"varies","spellType":"Pm","localizations":{"fr":{"name":"Vérité Véritable","description":"Version supérieure de Truth : peut produire soit un vaste champ de vérité, soit une détection de vérité à très grande distance selon l’usage choisi."},"en":{"name":"Truth True","description":"Superior version of Truth: may produce either a broad field of truth or truth detection at very great range, depending on the chosen use."}}},{"spellList":"Mind Visions","listType":"Base","profession":"Seer","name":"Finding True","label":"MERP_RMU.Seer.spells.FindingTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.FindingTrue.description","level":50,"description":"Comme Minor Finding, mais sans limite pratique de distance.","aoe":"caster","duration":"C","range":"unlimited","spellType":"Pm","localizations":{"fr":{"name":"Localisation Véritable","description":"Comme Minor Finding, mais sans limite pratique de distance."},"en":{"name":"Finding True","description":"As Minor Finding, but with no practical distance limit."}}}]},"_id":"AOxhIvVAdsSLHxGK"}
{"name":"Past Visions","type":"spell-list","img":"icons/magic/symbols/circled-gem-pink.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"seer-past-visions","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS","sourceBook":"Mentalism Companion","sourceList":"Past Visions","sourcePage":124,"merpRealm":"Mentalism","merpCategory":"Profession","profession":"Seer","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"rmss-spell-list-conversion","reference":"Mentalism Companion p.124; MERP/RMSS Seer p.149"},"compendiumSourceKey":"seer-past-visions","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-mentalism-seer","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Visions du Passé","system":{"name":"Visions du Passé","label":"Visions du Passé","notesLabel":"Visions du Passé — notes","notes":"<h2>Visions du Passé</h2><p>Évoque le passé des objets, personnes et lieux et permet d’analyser les événements, malédictions et souvenirs historiques.</p><p><strong>Conversion MERP-RMU :</strong> liste historique du Devin (Seer), structurée au format RMU tout en conservant ses effets et sa progression d’origine.</p>"}},"en":{"name":"Past Visions","system":{"name":"Past Visions","label":"Past Visions","notesLabel":"Past Visions — notes","notes":"<h2>Past Visions</h2><p>Reveals the past of objects, people, and places and allows the analysis of events, curses, and historical memories.</p><p><strong>MERP-RMU Conversion:</strong> historical Seer List, structured in RMU format while preserving its original effects and progression.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Mentalisme","Devin (Base)"],"en":["Mentalism Spell Lists","Seer (Base)"]},"compendiumFolderKeyPath":["spell-lists-mentalism","spell-lists-mentalism-seer"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / Mentalism Companion","name":"Past Visions","listType":"Base","realms":"Mentalism","profession":"Seer","notes":"<h2>Past Visions</h2><p>Reveals the past of objects, people, and places and allows the analysis of events, curses, and historical memories.</p><p><strong>MERP-RMU Conversion:</strong> historical Seer List, structured in RMU format while preserving its original effects and progression.</p>","label":"Past Visions","notesLabel":"Past Visions — notes","spells":[{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Origins","label":"MERP_RMU.Seer.spells.Origins.name","descriptionLabel":"MERP_RMU.Seer.spells.Origins.description","level":1,"description":"Donne une idée générale du lieu d’origine d’un objet.","aoe":"1 object","duration":"—","range":"touch","spellType":"I","localizations":{"fr":{"name":"Origines","description":"Donne une idée générale du lieu d’origine d’un objet."},"en":{"name":"Origins","description":"Gives a general idea of an object’s place of origin."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Detect Curse","label":"MERP_RMU.Seer.spells.DetectCurse.name","descriptionLabel":"MERP_RMU.Seer.spells.DetectCurse.description","level":2,"description":"Détecte l’existence d’une malédiction sur une personne, un objet ou un lieu.","aoe":"varies","duration":"—","range":"touch","spellType":"I","localizations":{"fr":{"name":"Détection de Malédiction","description":"Détecte l’existence d’une malédiction sur une personne, un objet ou un lieu."},"en":{"name":"Detect Curse","description":"Detects the existence of a curse on a person, object, or place."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Vision Behind I","label":"MERP_RMU.Seer.spells.VisionBehindI.name","descriptionLabel":"MERP_RMU.Seer.spells.VisionBehindI.description","level":3,"description":"Donne une vision du passé liée à la cible touchée, jusqu’à une minute par niveau dans le passé, avec une précision d’environ une minute.","aoe":"varies","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Vision du Passé I","description":"Donne une vision du passé liée à la cible touchée, jusqu’à une minute par niveau dans le passé, avec une précision d’environ une minute."},"en":{"name":"Vision Behind I","description":"Gives a vision of the past linked to the touched target, up to one minute per level into the past, with a precision of about one minute."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Power Lore","label":"MERP_RMU.Seer.spells.PowerLore.name","descriptionLabel":"MERP_RMU.Seer.spells.PowerLore.description","level":4,"description":"Révèle l’origine ou la nature générale du pouvoir d’un objet.","aoe":"1 item","duration":"—","range":"touch","spellType":"I","localizations":{"fr":{"name":"Connaissance de la Puissance","description":"Révèle l’origine ou la nature générale du pouvoir d’un objet."},"en":{"name":"Power Lore","description":"Reveals the origin or general nature of an object’s power."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Vision Guide","label":"MERP_RMU.Seer.spells.VisionGuide.name","descriptionLabel":"MERP_RMU.Seer.spells.VisionGuide.description","level":5,"description":"Repère dans le passé les moments où se sont produits des événements significatifs afin de guider une future Vision Behind.","aoe":"1 spell","duration":"varies","range":"self","spellType":"I","localizations":{"fr":{"name":"Guide des Visions","description":"Repère dans le passé les moments où se sont produits des événements significatifs afin de guider une future Vision Behind."},"en":{"name":"Vision Guide","description":"Identifies moments in the past when significant events occurred, helping guide a later Vision Behind."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Item Vision","label":"MERP_RMU.Seer.spells.ItemVision.name","descriptionLabel":"MERP_RMU.Seer.spells.ItemVision.description","level":6,"description":"Montre un événement significatif du passé d’un objet.","aoe":"1 item","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Vision d’Objet","description":"Montre un événement significatif du passé d’un objet."},"en":{"name":"Item Vision","description":"Shows one significant event from an object’s past."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Vision Behind II","label":"MERP_RMU.Seer.spells.VisionBehindII.name","descriptionLabel":"MERP_RMU.Seer.spells.VisionBehindII.description","level":7,"description":"Comme Vision Behind I, mais jusqu’à dix minutes par niveau dans le passé.","aoe":"varies","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Vision du Passé II","description":"Comme Vision Behind I, mais jusqu’à dix minutes par niveau dans le passé."},"en":{"name":"Vision Behind II","description":"As Vision Behind I, but up to ten minutes per level into the past."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Vision Enhancement","label":"MERP_RMU.Seer.spells.VisionEnhancement.name","descriptionLabel":"MERP_RMU.Seer.spells.VisionEnhancement.description","level":8,"description":"Améliore la prochaine Vision Behind en lui ajoutant un sens ou une capacité perceptive supplémentaire.","aoe":"1 spell","duration":"varies","range":"self","spellType":"I","localizations":{"fr":{"name":"Amélioration de Vision","description":"Améliore la prochaine Vision Behind en lui ajoutant un sens ou une capacité perceptive supplémentaire."},"en":{"name":"Vision Enhancement","description":"Improves the next Vision Behind by adding one additional sense or perceptive capability."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Vision Behind III","label":"MERP_RMU.Seer.spells.VisionBehindIII.name","descriptionLabel":"MERP_RMU.Seer.spells.VisionBehindIII.description","level":9,"description":"Comme Vision Behind I, mais jusqu’à une heure par niveau dans le passé.","aoe":"varies","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Vision du Passé III","description":"Comme Vision Behind I, mais jusqu’à une heure par niveau dans le passé."},"en":{"name":"Vision Behind III","description":"As Vision Behind I, but up to one hour per level into the past."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Delving","label":"MERP_RMU.Seer.spells.Delving.name","descriptionLabel":"MERP_RMU.Seer.spells.Delving.description","level":10,"description":"Révèle les détails importants de la construction et de la fonction d’un objet, sans nécessairement dévoiler précisément tous ses pouvoirs.","aoe":"1 item","duration":"—","range":"touch","spellType":"I","localizations":{"fr":{"name":"Investigation","description":"Révèle les détails importants de la construction et de la fonction d’un objet, sans nécessairement dévoiler précisément tous ses pouvoirs."},"en":{"name":"Delving","description":"Reveals important details of an object’s construction and function without necessarily disclosing all of its powers precisely."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Vision Behind IV","label":"MERP_RMU.Seer.spells.VisionBehindIV.name","descriptionLabel":"MERP_RMU.Seer.spells.VisionBehindIV.description","level":11,"description":"Comme Vision Behind I, mais jusqu’à un jour par niveau dans le passé.","aoe":"varies","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Vision du Passé IV","description":"Comme Vision Behind I, mais jusqu’à un jour par niveau dans le passé."},"en":{"name":"Vision Behind IV","description":"As Vision Behind I, but up to one day per level into the past."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Location Vision","label":"MERP_RMU.Seer.spells.LocationVision.name","descriptionLabel":"MERP_RMU.Seer.spells.LocationVision.description","level":12,"description":"Comme Item Vision, mais révèle un événement significatif lié au lieu où se trouve le Devin.","aoe":"1 location","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Vision de Lieu","description":"Comme Item Vision, mais révèle un événement significatif lié au lieu où se trouve le Devin."},"en":{"name":"Location Vision","description":"As Item Vision, but reveals a significant event connected to the place where the Seer is standing."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Past Store","label":"MERP_RMU.Seer.spells.PastStore.name","descriptionLabel":"MERP_RMU.Seer.spells.PastStore.description","level":13,"description":"Mémorise pendant une Vision Behind l’image d’une personne, d’un lieu ou d’un objet afin de l’utiliser comme clé pour de futures visions.","aoe":"1 spell","duration":"varies","range":"self","spellType":"I","localizations":{"fr":{"name":"Mémorisation du Passé","description":"Mémorise pendant une Vision Behind l’image d’une personne, d’un lieu ou d’un objet afin de l’utiliser comme clé pour de futures visions."},"en":{"name":"Past Store","description":"During a Vision Behind, stores the image of a person, place, or object for use as a key in future visions."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Curse Analysis","label":"MERP_RMU.Seer.spells.CurseAnalysis.name","descriptionLabel":"MERP_RMU.Seer.spells.CurseAnalysis.description","level":14,"description":"Analyse l’origine, la source, la puissance, la nature et l’efficacité approximative d’une malédiction.","aoe":"1 curse","duration":"—","range":"touch","spellType":"I","localizations":{"fr":{"name":"Analyse de Malédiction","description":"Analyse l’origine, la source, la puissance, la nature et l’efficacité approximative d’une malédiction."},"en":{"name":"Curse Analysis","description":"Analyzes a curse’s origin, source, power, nature, and approximate effectiveness."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Vision Behind V","label":"MERP_RMU.Seer.spells.VisionBehindV.name","descriptionLabel":"MERP_RMU.Seer.spells.VisionBehindV.description","level":15,"description":"Comme Vision Behind I, mais jusqu’à un mois par niveau dans le passé.","aoe":"varies","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Vision du Passé V","description":"Comme Vision Behind I, mais jusqu’à un mois par niveau dans le passé."},"en":{"name":"Vision Behind V","description":"As Vision Behind I, but up to one month per level into the past."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Item Analysis","label":"MERP_RMU.Seer.spells.ItemAnalysis.name","descriptionLabel":"MERP_RMU.Seer.spells.ItemAnalysis.description","level":16,"description":"Donne une analyse très complète de la construction, de la fonction et des pouvoirs d’un objet ; les objets exceptionnellement puissants peuvent rester partiellement obscurs.","aoe":"1 item","duration":"—","range":"6'","spellType":"I","localizations":{"fr":{"name":"Analyse d’Objet","description":"Donne une analyse très complète de la construction, de la fonction et des pouvoirs d’un objet ; les objets exceptionnellement puissants peuvent rester partiellement obscurs."},"en":{"name":"Item Analysis","description":"Provides a very complete analysis of an object’s construction, function, and powers; exceptionally powerful objects may remain partly obscure."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Vision Behind VI","label":"MERP_RMU.Seer.spells.VisionBehindVI.name","descriptionLabel":"MERP_RMU.Seer.spells.VisionBehindVI.description","level":17,"description":"Comme Vision Behind I, mais jusqu’à un an par niveau dans le passé.","aoe":"varies","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Vision du Passé VI","description":"Comme Vision Behind I, mais jusqu’à un an par niveau dans le passé."},"en":{"name":"Vision Behind VI","description":"As Vision Behind I, but up to one year per level into the past."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Person Vision","label":"MERP_RMU.Seer.spells.PersonVision.name","descriptionLabel":"MERP_RMU.Seer.spells.PersonVision.description","level":18,"description":"Comme Item Vision, mais pour un événement significatif du passé d’un être vivant.","aoe":"1 being","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Vision de Personne","description":"Comme Item Vision, mais pour un événement significatif du passé d’un être vivant."},"en":{"name":"Person Vision","description":"As Item Vision, but for a significant event in a living being’s past."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Evoke Vision","label":"MERP_RMU.Seer.spells.EvokeVision.name","descriptionLabel":"MERP_RMU.Seer.spells.EvokeVision.description","level":19,"description":"Projette une Vision Behind dans un support approprié afin que d’autres personnes puissent en voir les aspects visuels.","aoe":"1 item","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Évocation de Vision","description":"Projette une Vision Behind dans un support approprié afin que d’autres personnes puissent en voir les aspects visuels."},"en":{"name":"Evoke Vision","description":"Projects a Vision Behind into an appropriate medium so that other people can see its visual aspects."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Vision Hold","label":"MERP_RMU.Seer.spells.VisionHold.name","descriptionLabel":"MERP_RMU.Seer.spells.VisionHold.description","level":20,"description":"À partir d’une description générale d’un événement, guide la prochaine Vision Behind vers l’événement correspondant le plus proche.","aoe":"caster","duration":"varies","range":"self","spellType":"U","localizations":{"fr":{"name":"Fixation de Vision","description":"À partir d’une description générale d’un événement, guide la prochaine Vision Behind vers l’événement correspondant le plus proche."},"en":{"name":"Vision Hold","description":"Using a general description of an event, guides the next Vision Behind toward the nearest matching event."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Vision Behind VII","label":"MERP_RMU.Seer.spells.VisionBehindVII.name","descriptionLabel":"MERP_RMU.Seer.spells.VisionBehindVII.description","level":25,"description":"Comme Vision Behind I, mais jusqu’à dix ans par niveau dans le passé.","aoe":"varies","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Vision du Passé VII","description":"Comme Vision Behind I, mais jusqu’à dix ans par niveau dans le passé."},"en":{"name":"Vision Behind VII","description":"As Vision Behind I, but up to ten years per level into the past."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Vision Behind VIII","label":"MERP_RMU.Seer.spells.VisionBehindVIII.name","descriptionLabel":"MERP_RMU.Seer.spells.VisionBehindVIII.description","level":30,"description":"Comme Vision Behind I, mais jusqu’à cent ans par niveau dans le passé.","aoe":"varies","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Vision du Passé VIII","description":"Comme Vision Behind I, mais jusqu’à cent ans par niveau dans le passé."},"en":{"name":"Vision Behind VIII","description":"As Vision Behind I, but up to one hundred years per level into the past."}}},{"spellList":"Past Visions","listType":"Base","profession":"Seer","name":"Vision Behind True","label":"MERP_RMU.Seer.spells.VisionBehindTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.VisionBehindTrue.description","level":50,"description":"Permet de regarder arbitrairement loin dans le passé, avec une précision réduite à l’échelle historique.","aoe":"varies","duration":"varies","range":"touch","spellType":"I","localizations":{"fr":{"name":"Vision du Passé Véritable","description":"Permet de regarder arbitrairement loin dans le passé, avec une précision réduite à l’échelle historique."},"en":{"name":"Vision Behind True","description":"Allows the Seer to look arbitrarily far into the past, with precision reduced to a historical scale."}}}]},"_id":"CWOHWNrNTJBazDmg"}
{"name":"Vision Borrowing","type":"spell-list","img":"icons/magic/symbols/circled-gem-pink.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"seer-vision-borrowing","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS","sourceBook":"Mentalism Companion","sourceList":"Vision Borrowing","sourcePage":125,"merpRealm":"Mentalism","merpCategory":"Profession","profession":"Seer","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"rmss-spell-list-conversion","reference":"Mentalism Companion p.125; MERP/RMSS Seer p.149"},"compendiumSourceKey":"seer-vision-borrowing","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-mentalism-seer","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Emprunt de Vision","system":{"name":"Emprunt de Vision","label":"Emprunt de Vision","notesLabel":"Emprunt de Vision — notes","notes":"<h2>Emprunt de Vision</h2><p>Emprunte les sens d’animaux ou d’autres êtres, fusionne les perceptions et permet la scrutation à distance.</p><p><strong>Conversion MERP-RMU :</strong> liste historique du Devin (Seer), structurée au format RMU tout en conservant ses effets et sa progression d’origine.</p>"}},"en":{"name":"Vision Borrowing","system":{"name":"Vision Borrowing","label":"Vision Borrowing","notesLabel":"Vision Borrowing — notes","notes":"<h2>Vision Borrowing</h2><p>Borrows the senses of animals or other beings, merges perceptions, and enables remote scrying.</p><p><strong>MERP-RMU Conversion:</strong> historical Seer List, structured in RMU format while preserving its original effects and progression.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Mentalisme","Devin (Base)"],"en":["Mentalism Spell Lists","Seer (Base)"]},"compendiumFolderKeyPath":["spell-lists-mentalism","spell-lists-mentalism-seer"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / Mentalism Companion","name":"Vision Borrowing","listType":"Base","realms":"Mentalism","profession":"Seer","notes":"<h2>Vision Borrowing</h2><p>Borrows the senses of animals or other beings, merges perceptions, and enables remote scrying.</p><p><strong>MERP-RMU Conversion:</strong> historical Seer List, structured in RMU format while preserving its original effects and progression.</p>","label":"Vision Borrowing","notesLabel":"Vision Borrowing — notes","spells":[{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Animal Sight I","label":"MERP_RMU.Seer.spells.AnimalSightI.name","descriptionLabel":"MERP_RMU.Seer.spells.AnimalSightI.description","level":1,"description":"Permet de voir à travers les yeux d’un animal non intelligent situé à portée.","aoe":"caster + 1 target","duration":"C","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Vue Animale I","description":"Permet de voir à travers les yeux d’un animal non intelligent situé à portée."},"en":{"name":"Animal Sight I","description":"Allows the Seer to see through the eyes of a non-intelligent animal within range."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Animal Hearing I","label":"MERP_RMU.Seer.spells.AnimalHearingI.name","descriptionLabel":"MERP_RMU.Seer.spells.AnimalHearingI.description","level":2,"description":"Permet d’entendre à travers l’ouïe d’un animal non intelligent situé à portée.","aoe":"caster + 1 target","duration":"C","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Ouïe Animale I","description":"Permet d’entendre à travers l’ouïe d’un animal non intelligent situé à portée."},"en":{"name":"Animal Hearing I","description":"Allows the Seer to hear through the hearing of a non-intelligent animal within range."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Animal Sense I","label":"MERP_RMU.Seer.spells.AnimalSenseI.name","descriptionLabel":"MERP_RMU.Seer.spells.AnimalSenseI.description","level":3,"description":"Permet d’emprunter un ou plusieurs sens d’un animal non intelligent.","aoe":"caster + 1 target","duration":"C","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Sens Animal I","description":"Permet d’emprunter un ou plusieurs sens d’un animal non intelligent."},"en":{"name":"Animal Sense I","description":"Allows the Seer to borrow one or more senses from a non-intelligent animal."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Sight Merge I","label":"MERP_RMU.Seer.spells.SightMergeI.name","descriptionLabel":"MERP_RMU.Seer.spells.SightMergeI.description","level":4,"description":"Permet de voir à travers les yeux de n’importe quel être situé à portée.","aoe":"caster + 1 target","duration":"C","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Fusion de Vue I","description":"Permet de voir à travers les yeux de n’importe quel être situé à portée."},"en":{"name":"Sight Merge I","description":"Allows the Seer to see through the eyes of any being within range."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Hearing Merge I","label":"MERP_RMU.Seer.spells.HearingMergeI.name","descriptionLabel":"MERP_RMU.Seer.spells.HearingMergeI.description","level":5,"description":"Permet d’entendre à travers l’ouïe de n’importe quel être situé à portée.","aoe":"caster + 1 target","duration":"C","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Fusion d’Ouïe I","description":"Permet d’entendre à travers l’ouïe de n’importe quel être situé à portée."},"en":{"name":"Hearing Merge I","description":"Allows the Seer to hear through the hearing of any being within range."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Animal Sight III","label":"MERP_RMU.Seer.spells.AnimalSightIII.name","descriptionLabel":"MERP_RMU.Seer.spells.AnimalSightIII.description","level":6,"description":"Comme Animal Sight I, avec une portée de 300 pieds.","aoe":"caster + 1 target","duration":"C","range":"300'","spellType":"Pm","localizations":{"fr":{"name":"Vue Animale III","description":"Comme Animal Sight I, avec une portée de 300 pieds."},"en":{"name":"Animal Sight III","description":"As Animal Sight I, but with a range of 300 feet."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Scrying I","label":"MERP_RMU.Seer.spells.ScryingI.name","descriptionLabel":"MERP_RMU.Seer.spells.ScryingI.description","level":7,"description":"Permet de scruter une personne, un objet ou un lieu précisément décrit à travers un support de divination ; la portée dépend du caractère mobile ou fixe de la cible.","aoe":"1 item/medium","duration":"C","range":"varies","spellType":"Pm","localizations":{"fr":{"name":"Scrutation I","description":"Permet de scruter une personne, un objet ou un lieu précisément décrit à travers un support de divination ; la portée dépend du caractère mobile ou fixe de la cible."},"en":{"name":"Scrying I","description":"Allows the Seer to scry a precisely described person, object, or place through a divinatory medium; range depends on whether the target is mobile or fixed."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Animal Sense III","label":"MERP_RMU.Seer.spells.AnimalSenseIII.name","descriptionLabel":"MERP_RMU.Seer.spells.AnimalSenseIII.description","level":8,"description":"Comme Animal Sense I, avec une portée de 300 pieds.","aoe":"caster + 1 target","duration":"C","range":"300'","spellType":"Pm","localizations":{"fr":{"name":"Sens Animal III","description":"Comme Animal Sense I, avec une portée de 300 pieds."},"en":{"name":"Animal Sense III","description":"As Animal Sense I, but with a range of 300 feet."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Comprehend Borrowed Sense","label":"MERP_RMU.Seer.spells.ComprehendBorrowedSense.name","descriptionLabel":"MERP_RMU.Seer.spells.ComprehendBorrowedSense.description","level":9,"description":"Permet d’interpréter correctement des informations sensorielles provenant d’un sens que le Devin ne possède pas naturellement.","aoe":"caster","duration":"varies","range":"self","spellType":"U","localizations":{"fr":{"name":"Compréhension d’un Sens Emprunté","description":"Permet d’interpréter correctement des informations sensorielles provenant d’un sens que le Devin ne possède pas naturellement."},"en":{"name":"Comprehend Borrowed Sense","description":"Allows correct interpretation of sensory information coming from a sense the Seer does not naturally possess."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Sight Merge III","label":"MERP_RMU.Seer.spells.SightMergeIII.name","descriptionLabel":"MERP_RMU.Seer.spells.SightMergeIII.description","level":10,"description":"Comme Sight Merge I, avec une portée de 300 pieds.","aoe":"caster + 1 target","duration":"C","range":"300'","spellType":"Pm","localizations":{"fr":{"name":"Fusion de Vue III","description":"Comme Sight Merge I, avec une portée de 300 pieds."},"en":{"name":"Sight Merge III","description":"As Sight Merge I, but with a range of 300 feet."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Animal Sight V","label":"MERP_RMU.Seer.spells.AnimalSightV.name","descriptionLabel":"MERP_RMU.Seer.spells.AnimalSightV.description","level":11,"description":"Comme Animal Sight I, avec une portée de 500 pieds.","aoe":"caster + 1 target","duration":"C","range":"500'","spellType":"Pm","localizations":{"fr":{"name":"Vue Animale V","description":"Comme Animal Sight I, avec une portée de 500 pieds."},"en":{"name":"Animal Sight V","description":"As Animal Sight I, but with a range of 500 feet."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Sensory Merge I","label":"MERP_RMU.Seer.spells.SensoryMergeI.name","descriptionLabel":"MERP_RMU.Seer.spells.SensoryMergeI.description","level":12,"description":"Comme Animal Sense, mais peut emprunter n’importe quels sens d’un être pensant ou non.","aoe":"caster + 1 target","duration":"C","range":"100'","spellType":"Pm","localizations":{"fr":{"name":"Fusion Sensorielle I","description":"Comme Animal Sense, mais peut emprunter n’importe quels sens d’un être pensant ou non."},"en":{"name":"Sensory Merge I","description":"As Animal Sense, but may borrow any senses from either a thinking or non-thinking being."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Animal Sense V","label":"MERP_RMU.Seer.spells.AnimalSenseV.name","descriptionLabel":"MERP_RMU.Seer.spells.AnimalSenseV.description","level":13,"description":"Comme Animal Sense I, avec une portée de 500 pieds.","aoe":"caster + 1 target","duration":"C","range":"500'","spellType":"Pm","localizations":{"fr":{"name":"Sens Animal V","description":"Comme Animal Sense I, avec une portée de 500 pieds."},"en":{"name":"Animal Sense V","description":"As Animal Sense I, but with a range of 500 feet."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Scrying II","label":"MERP_RMU.Seer.spells.ScryingII.name","descriptionLabel":"MERP_RMU.Seer.spells.ScryingII.description","level":14,"description":"Comme Scrying I, avec une portée d’un mile par niveau pour une cible mobile et dix miles par niveau pour une cible fixe.","aoe":"1 item","duration":"C","range":"varies","spellType":"Pm","localizations":{"fr":{"name":"Scrutation II","description":"Comme Scrying I, avec une portée d’un mile par niveau pour une cible mobile et dix miles par niveau pour une cible fixe."},"en":{"name":"Scrying II","description":"As Scrying I, but with a range of one mile per level for a mobile target and ten miles per level for a fixed target."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Sight Merge V","label":"MERP_RMU.Seer.spells.SightMergeV.name","descriptionLabel":"MERP_RMU.Seer.spells.SightMergeV.description","level":15,"description":"Comme Sight Merge I, avec une portée de 500 pieds.","aoe":"caster + 1 target","duration":"C","range":"500'","spellType":"Pm","localizations":{"fr":{"name":"Fusion de Vue V","description":"Comme Sight Merge I, avec une portée de 500 pieds."},"en":{"name":"Sight Merge V","description":"As Sight Merge I, but with a range of 500 feet."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Animal Sight True","label":"MERP_RMU.Seer.spells.AnimalSightTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.AnimalSightTrue.description","level":16,"description":"Comme Animal Sight I, avec une portée d’un mile par niveau.","aoe":"caster + 1 target","duration":"C","range":"1 mile/lvl","spellType":"Pm","localizations":{"fr":{"name":"Vue Animale Véritable","description":"Comme Animal Sight I, avec une portée d’un mile par niveau."},"en":{"name":"Animal Sight True","description":"As Animal Sight I, but with a range of one mile per level."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Scrying Share","label":"MERP_RMU.Seer.spells.ScryingShare.name","descriptionLabel":"MERP_RMU.Seer.spells.ScryingShare.description","level":17,"description":"Permet à plusieurs personnes préparées de partager ce que le Devin voit au moyen d’un sort de Scrying.","aoe":"varies","duration":"varies","range":"varies","spellType":"Pm","localizations":{"fr":{"name":"Partage de Scrutation","description":"Permet à plusieurs personnes préparées de partager ce que le Devin voit au moyen d’un sort de Scrying."},"en":{"name":"Scrying Share","description":"Allows several prepared people to share what the Seer sees through a Scrying spell."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Sensory Merge III","label":"MERP_RMU.Seer.spells.SensoryMergeIII.name","descriptionLabel":"MERP_RMU.Seer.spells.SensoryMergeIII.description","level":18,"description":"Comme Sensory Merge I, avec une portée de 300 pieds.","aoe":"caster + 1 target","duration":"C","range":"300'","spellType":"Pm","localizations":{"fr":{"name":"Fusion Sensorielle III","description":"Comme Sensory Merge I, avec une portée de 300 pieds."},"en":{"name":"Sensory Merge III","description":"As Sensory Merge I, but with a range of 300 feet."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Animal Sense True","label":"MERP_RMU.Seer.spells.AnimalSenseTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.AnimalSenseTrue.description","level":19,"description":"Comme Animal Sense I, avec une portée d’un mile par niveau.","aoe":"caster + 1 target","duration":"C","range":"1 mile/lvl","spellType":"Pm","localizations":{"fr":{"name":"Sens Animal Véritable","description":"Comme Animal Sense I, avec une portée d’un mile par niveau."},"en":{"name":"Animal Sense True","description":"As Animal Sense I, but with a range of one mile per level."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Sight Merge True","label":"MERP_RMU.Seer.spells.SightMergeTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.SightMergeTrue.description","level":20,"description":"Comme Sight Merge I, avec une portée d’un mile par niveau.","aoe":"caster + 1 target","duration":"C","range":"1 mile/lvl","spellType":"Pm","localizations":{"fr":{"name":"Fusion de Vue Véritable","description":"Comme Sight Merge I, avec une portée d’un mile par niveau."},"en":{"name":"Sight Merge True","description":"As Sight Merge I, but with a range of one mile per level."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Long Sensory Merge","label":"MERP_RMU.Seer.spells.LongSensoryMerge.name","descriptionLabel":"MERP_RMU.Seer.spells.LongSensoryMerge.description","level":25,"description":"Comme Sensory Merge I, avec une portée d’un mile par niveau.","aoe":"caster + 1 target","duration":"C","range":"1 mile/lvl","spellType":"Pm","localizations":{"fr":{"name":"Fusion Sensorielle Lointaine","description":"Comme Sensory Merge I, avec une portée d’un mile par niveau."},"en":{"name":"Long Sensory Merge","description":"As Sensory Merge I, but with a range of one mile per level."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Scrying True","label":"MERP_RMU.Seer.spells.ScryingTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.ScryingTrue.description","level":30,"description":"Comme Scrying I, avec une portée de dix miles par niveau pour une cible mobile et cent miles par niveau pour une cible fixe.","aoe":"1 item","duration":"C","range":"varies","spellType":"Pm","localizations":{"fr":{"name":"Scrutation Véritable","description":"Comme Scrying I, avec une portée de dix miles par niveau pour une cible mobile et cent miles par niveau pour une cible fixe."},"en":{"name":"Scrying True","description":"As Scrying I, but with a range of ten miles per level for a mobile target and one hundred miles per level for a fixed target."}}},{"spellList":"Vision Borrowing","listType":"Base","profession":"Seer","name":"Sensory Merge True","label":"MERP_RMU.Seer.spells.SensoryMergeTrue.name","descriptionLabel":"MERP_RMU.Seer.spells.SensoryMergeTrue.description","level":50,"description":"Comme Sensory Merge I, mais sans limite pratique de portée.","aoe":"caster + 1 target","duration":"C","range":"unlimited","spellType":"Pm","localizations":{"fr":{"name":"Fusion Sensorielle Véritable","description":"Comme Sensory Merge I, mais sans limite pratique de portée."},"en":{"name":"Sensory Merge True","description":"As Sensory Merge I, but with no practical range limit."}}}]},"_id":"NGPDx1k3XwNyNhrk"}
{"name":"Vision Guard","type":"spell-list","img":"icons/magic/symbols/circled-gem-pink.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"seer-vision-guard","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS","sourceBook":"Mentalism Companion","sourceList":"Vision Guard","sourcePage":126,"merpRealm":"Mentalism","merpCategory":"Profession","profession":"Seer","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"rmss-spell-list-conversion","reference":"Mentalism Companion p.126; MERP/RMSS Seer p.149"},"compendiumSourceKey":"seer-vision-guard","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-mentalism-seer","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Garde des Visions","system":{"name":"Garde des Visions","label":"Garde des Visions","notesLabel":"Garde des Visions — notes","notes":"<h2>Garde des Visions</h2><p>Protège contre la scrutation, la divination et l’exploration du passé ou de l’esprit, et permet de détecter ou détourner ces tentatives.</p><p><strong>Conversion MERP-RMU :</strong> liste historique du Devin (Seer), structurée au format RMU tout en conservant ses effets et sa progression d’origine.</p>"}},"en":{"name":"Vision Guard","system":{"name":"Vision Guard","label":"Vision Guard","notesLabel":"Vision Guard — notes","notes":"<h2>Vision Guard</h2><p>Protects against scrying, divination, and investigation of the past or the mind, and allows such attempts to be detected or diverted.</p><p><strong>MERP-RMU Conversion:</strong> historical Seer List, structured in RMU format while preserving its original effects and progression.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Mentalisme","Devin (Base)"],"en":["Mentalism Spell Lists","Seer (Base)"]},"compendiumFolderKeyPath":["spell-lists-mentalism","spell-lists-mentalism-seer"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / Mentalism Companion","name":"Vision Guard","listType":"Base","realms":"Mentalism","profession":"Seer","notes":"<h2>Vision Guard</h2><p>Protects against scrying, divination, and investigation of the past or the mind, and allows such attempts to be detected or diverted.</p><p><strong>MERP-RMU Conversion:</strong> historical Seer List, structured in RMU format while preserving its original effects and progression.</p>","label":"Vision Guard","notesLabel":"Vision Guard — notes","spells":[{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Detect Scrying","label":"MERP_RMU.Seer.spells.DetectScrying.name","descriptionLabel":"MERP_RMU.Seer.spells.DetectScrying.description","level":1,"description":"Détecte si un être, objet ou lieu dans une petite zone est actuellement la cible d’une scrutation ; le Devin peut examiner une zone différente chaque round.","aoe":"5'R","duration":"1 min/lvl (C)","range":"50'","spellType":"P","localizations":{"fr":{"name":"Détection de Scrutation","description":"Détecte si un être, objet ou lieu dans une petite zone est actuellement la cible d’une scrutation ; le Devin peut examiner une zone différente chaque round."},"en":{"name":"Detect Scrying","description":"Detects whether a being, object, or place within a small area is currently being scryed; the Seer may examine a different area each round."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Detect Divination","label":"MERP_RMU.Seer.spells.DetectDivination.name","descriptionLabel":"MERP_RMU.Seer.spells.DetectDivination.description","level":2,"description":"Détecte si une tentative de divination concerne le futur d’un être, objet ou lieu dans la zone examinée.","aoe":"5'R","duration":"1 min/lvl (C)","range":"50'","spellType":"P","localizations":{"fr":{"name":"Détection de Divination","description":"Détecte si une tentative de divination concerne le futur d’un être, objet ou lieu dans la zone examinée."},"en":{"name":"Detect Divination","description":"Detects whether a divination attempt concerns the future of a being, object, or place in the examined area."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Cloud Scrying","label":"MERP_RMU.Seer.spells.CloudScrying.name","descriptionLabel":"MERP_RMU.Seer.spells.CloudScrying.description","level":3,"description":"Brouille les tentatives de scrutation visant le sujet touché ; un scryer ne reçoit qu’une partie de l’information tant que la protection tient.","aoe":"1 subject","duration":"1 hr/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Brouillage de Scrutation","description":"Brouille les tentatives de scrutation visant le sujet touché ; un scryer ne reçoit qu’une partie de l’information tant que la protection tient."},"en":{"name":"Cloud Scrying","description":"Obscures scrying attempts directed at the touched subject; a scryer receives only part of the information while the protection holds."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Conceal Fate","label":"MERP_RMU.Seer.spells.ConcealFate.name","descriptionLabel":"MERP_RMU.Seer.spells.ConcealFate.description","level":4,"description":"Dissimule une destinée ou malédiction particulière aux sorts qui tentent de la détecter, sans supprimer son effet réel.","aoe":"1 subject","duration":"1 hr/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Dissimulation du Destin","description":"Dissimule une destinée ou malédiction particulière aux sorts qui tentent de la détecter, sans supprimer son effet réel."},"en":{"name":"Conceal Fate","description":"Conceals one specific destiny or curse from spells attempting to detect it without removing its actual effect."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Scrying Misdirection","label":"MERP_RMU.Seer.spells.ScryingMisdirection.name","descriptionLabel":"MERP_RMU.Seer.spells.ScryingMisdirection.description","level":5,"description":"Redirige une tentative de scrutation vers un sujet similaire choisi lors du lancement, si un leurre approprié existe à proximité.","aoe":"1 subject","duration":"1 hr/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Détournement de Scrutation","description":"Redirige une tentative de scrutation vers un sujet similaire choisi lors du lancement, si un leurre approprié existe à proximité."},"en":{"name":"Scrying Misdirection","description":"Redirects a scrying attempt toward a similar subject chosen when the spell is cast, provided a suitable decoy exists nearby."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Shadow Past","label":"MERP_RMU.Seer.spells.ShadowPast.name","descriptionLabel":"MERP_RMU.Seer.spells.ShadowPast.description","level":6,"description":"Brouille les actes du sujet dans les visions du passé, rendant son rôle difficile à percevoir.","aoe":"1 target","duration":"1 min/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Passé Obscurci","description":"Brouille les actes du sujet dans les visions du passé, rendant son rôle difficile à percevoir."},"en":{"name":"Shadow Past","description":"Obscures the subject’s actions in visions of the past, making their role difficult to perceive."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"False Truth","label":"MERP_RMU.Seer.spells.FalseTruth.name","descriptionLabel":"MERP_RMU.Seer.spells.FalseTruth.description","level":7,"description":"Si le sujet résiste à un sort de lecture mentale ou de vérité, il peut présenter une fausse version comme si elle était vraie.","aoe":"1 subject","duration":"1 min/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Fausse Vérité","description":"Si le sujet résiste à un sort de lecture mentale ou de vérité, il peut présenter une fausse version comme si elle était vraie."},"en":{"name":"False Truth","description":"If the subject resists a mind-reading or truth spell, they may present a false version as though it were true."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"False Anticipations","label":"MERP_RMU.Seer.spells.FalseAnticipations.name","descriptionLabel":"MERP_RMU.Seer.spells.FalseAnticipations.description","level":8,"description":"Trompe les sorts d’anticipation portant sur le sujet, en fournissant de fausses intentions ou en neutralisant leurs avantages.","aoe":"1 subject","duration":"1 min/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Fausses Anticipations","description":"Trompe les sorts d’anticipation portant sur le sujet, en fournissant de fausses intentions ou en neutralisant leurs avantages."},"en":{"name":"False Anticipations","description":"Deceives anticipation spells concerning the subject by supplying false intentions or neutralizing their advantages."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"False Scrying","label":"MERP_RMU.Seer.spells.FalseScrying.name","descriptionLabel":"MERP_RMU.Seer.spells.FalseScrying.description","level":9,"description":"Prépare une image fausse et simple qui remplace la vision réelle obtenue par une tentative de scrutation sur le sujet.","aoe":"1 subject","duration":"1 hr/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Fausse Scrutation","description":"Prépare une image fausse et simple qui remplace la vision réelle obtenue par une tentative de scrutation sur le sujet."},"en":{"name":"False Scrying","description":"Prepares a simple false image that replaces the true vision obtained by a scrying attempt directed at the subject."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Cloud Portent","label":"MERP_RMU.Seer.spells.CloudPortent.name","descriptionLabel":"MERP_RMU.Seer.spells.CloudPortent.description","level":10,"description":"Comme Cloud Scrying, mais contre les sorts de divination portant sur le futur du sujet.","aoe":"1 subject","duration":"1 hr/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Brouillage de Présage","description":"Comme Cloud Scrying, mais contre les sorts de divination portant sur le futur du sujet."},"en":{"name":"Cloud Portent","description":"As Cloud Scrying, but against divination spells concerning the subject’s future."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Feel Scrying","label":"MERP_RMU.Seer.spells.FeelScrying.name","descriptionLabel":"MERP_RMU.Seer.spells.FeelScrying.description","level":11,"description":"Le Devin ressent constamment les tentatives de scrutation qui le prennent pour cible.","aoe":"caster","duration":"constant","range":"self","spellType":"Pm","localizations":{"fr":{"name":"Sentir la Scrutation","description":"Le Devin ressent constamment les tentatives de scrutation qui le prennent pour cible."},"en":{"name":"Feel Scrying","description":"The Seer constantly senses scrying attempts that target them."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Feel Divination","label":"MERP_RMU.Seer.spells.FeelDivination.name","descriptionLabel":"MERP_RMU.Seer.spells.FeelDivination.description","level":12,"description":"Le Devin ressent constamment les tentatives de divination qui portent sur son avenir.","aoe":"caster","duration":"constant","range":"self","spellType":"Pm","localizations":{"fr":{"name":"Sentir la Divination","description":"Le Devin ressent constamment les tentatives de divination qui portent sur son avenir."},"en":{"name":"Feel Divination","description":"The Seer constantly senses divination attempts concerning their future."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Unknown Past","label":"MERP_RMU.Seer.spells.UnknownPast.name","descriptionLabel":"MERP_RMU.Seer.spells.UnknownPast.description","level":14,"description":"Efface le sujet des visions du passé : les scènes restent visibles mais ne fournissent aucune information permettant d’identifier sa participation.","aoe":"1 target","duration":"1 min/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Passé Inconnu","description":"Efface le sujet des visions du passé : les scènes restent visibles mais ne fournissent aucune information permettant d’identifier sa participation."},"en":{"name":"Unknown Past","description":"Erases the subject from visions of the past: scenes remain visible but reveal no information that could identify the subject’s participation."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"False Portent","label":"MERP_RMU.Seer.spells.FalsePortent.name","descriptionLabel":"MERP_RMU.Seer.spells.FalsePortent.description","level":15,"description":"Toute divination portant sur le sujet protégé reçoit une fausse lecture déterminée lors du lancement.","aoe":"1 target","duration":"1 hr/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Faux Présage","description":"Toute divination portant sur le sujet protégé reçoit une fausse lecture déterminée lors du lancement."},"en":{"name":"False Portent","description":"Any divination concerning the protected subject receives a false reading determined when the spell is cast."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Conceal Presence","label":"MERP_RMU.Seer.spells.ConcealPresence.name","descriptionLabel":"MERP_RMU.Seer.spells.ConcealPresence.description","level":16,"description":"Le sujet paraît ne posséder aucune présence mentale et échappe aux sorts de type Presence.","aoe":"1 target","duration":"1 min/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Dissimulation de Présence","description":"Le sujet paraît ne posséder aucune présence mentale et échappe aux sorts de type Presence."},"en":{"name":"Conceal Presence","description":"The subject appears to possess no mental presence and escapes Presence-type spells."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Scrying Analysis","label":"MERP_RMU.Seer.spells.ScryingAnalysis.name","descriptionLabel":"MERP_RMU.Seer.spells.ScryingAnalysis.description","level":17,"description":"Analyse une scrutation détectée afin de localiser et d’identifier le scryer.","aoe":"1 scryer","duration":"—","range":"self","spellType":"Pm","localizations":{"fr":{"name":"Analyse de Scrutation","description":"Analyse une scrutation détectée afin de localiser et d’identifier le scryer."},"en":{"name":"Scrying Analysis","description":"Analyzes a detected scrying attempt in order to locate and identify the scryer."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Divination Analysis","label":"MERP_RMU.Seer.spells.DivinationAnalysis.name","descriptionLabel":"MERP_RMU.Seer.spells.DivinationAnalysis.description","level":18,"description":"Analyse une divination détectée afin de localiser et d’identifier le divinateur.","aoe":"1 diviner","duration":"—","range":"self","spellType":"Pm","localizations":{"fr":{"name":"Analyse de Divination","description":"Analyse une divination détectée afin de localiser et d’identifier le divinateur."},"en":{"name":"Divination Analysis","description":"Analyzes a detected divination attempt in order to locate and identify the diviner."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"False Past","label":"MERP_RMU.Seer.spells.FalsePast.name","descriptionLabel":"MERP_RMU.Seer.spells.FalsePast.description","level":20,"description":"Modifie les visions du passé de sorte que les actes du sujet semblent avoir été accomplis par une autre personne choisie au lancement.","aoe":"1 target","duration":"1 min/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Faux Passé","description":"Modifie les visions du passé de sorte que les actes du sujet semblent avoir été accomplis par une autre personne choisie au lancement."},"en":{"name":"False Past","description":"Alters visions of the past so that the subject’s actions appear to have been performed by another person chosen when the spell is cast."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Conceal Memories","label":"MERP_RMU.Seer.spells.ConcealMemories.name","descriptionLabel":"MERP_RMU.Seer.spells.ConcealMemories.description","level":25,"description":"Dissimule aux lectures mentales un nombre de scènes ou souvenirs égal au niveau du Devin ; le sujet conserve toutefois ses vrais souvenirs.","aoe":"1 target","duration":"1 hr/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Dissimulation des Souvenirs","description":"Dissimule aux lectures mentales un nombre de scènes ou souvenirs égal au niveau du Devin ; le sujet conserve toutefois ses vrais souvenirs."},"en":{"name":"Conceal Memories","description":"Conceals from mind-reading a number of scenes or memories equal to the Seer’s level; the subject nevertheless retains the true memories."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"False Memories","label":"MERP_RMU.Seer.spells.FalseMemories.name","descriptionLabel":"MERP_RMU.Seer.spells.FalseMemories.description","level":30,"description":"Implante des souvenirs factices en plus des souvenirs réels, à raison d’un souvenir ou d’une scène par round.","aoe":"1 target","duration":"1 rnd/lvl","range":"touch","spellType":"Fm","localizations":{"fr":{"name":"Faux Souvenirs","description":"Implante des souvenirs factices en plus des souvenirs réels, à raison d’un souvenir ou d’une scène par round."},"en":{"name":"False Memories","description":"Implants false memories in addition to the real ones, at the rate of one memory or scene per round."}}},{"spellList":"Vision Guard","listType":"Base","profession":"Seer","name":"Outside the Weave","label":"MERP_RMU.Seer.spells.OutsidetheWeave.name","descriptionLabel":"MERP_RMU.Seer.spells.OutsidetheWeave.description","level":50,"description":"Protège totalement le sujet contre toute magie divinatoire pendant la durée. Les divinations le concernant échouent ou omettent sa présence ; le sujet lui-même ne peut utiliser de divination tant qu’il est ainsi retranché.","aoe":"1 subject","duration":"1 hr/lvl","range":"touch","spellType":"F","localizations":{"fr":{"name":"Hors de la Trame","description":"Protège totalement le sujet contre toute magie divinatoire pendant la durée. Les divinations le concernant échouent ou omettent sa présence ; le sujet lui-même ne peut utiliser de divination tant qu’il est ainsi retranché."},"en":{"name":"Outside the Weave","description":"Completely protects the subject from all divinatory magic for the duration. Divinations concerning the subject fail or omit the subject’s presence; the subject cannot use divination while thus removed."}}}]},"_id":"9P8QAzlm8eglmuBz"}
