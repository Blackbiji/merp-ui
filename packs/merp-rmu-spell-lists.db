30,"description":"As Armour I, but grants +20 general or +25 against one broad group.","aoe":"self","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Armure IV","description":"Comme Armure I, mais confère +20 en général ou +25 contre un vaste groupe de créatures."},"en":{"name":"Armour IV","description":"As Armour I, but grants +20 general or +25 against one broad group."}}},{"spellList":"Armourer","listType":"Base","profession":"Razak-zinul","name":"Mystical Armour","label":"MERP_RMU.RazakZinul.armourer.spells.MysticalArmour.name","descriptionLabel":"MERP_RMU.RazakZinul.armourer.spells.MysticalArmour.description","level":50,"description":"Creates the list’s ultimate magical armour protection for the caster.","aoe":"caster","duration":"1 min/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Armure Mystique","description":"Crée pour le lanceur la protection d’armure magique ultime de cette liste."},"en":{"name":"Mystical Armour","description":"Creates the list’s ultimate magical armour protection for the caster."}}}]},"_id":"ud3WZGkkoRqBPZdx"}
{"name":"Craftsman","type":"spell-list","img":"icons/magic/symbols/rune-sigil-horned-white-purple.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"razak-zinul-craftsman","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS/MERP","sourceBook":"MERP Character Creation Using RMSS/RMFRP v2.5","sourceList":"Craftsman","sourcePage":239,"merpRealm":"Channeling","merpCategory":"Profession","profession":"Razak-zinul","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"merp-rmss-spell-list-conversion","reference":"MERP/RMSS v2.5 pp. 239; Razak-zinul Base List"},"compendiumSourceKey":"razak-zinul-craftsman","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-channeling-razak-zinul","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Artisan","system":{"name":"Artisan","label":"Artisan","notesLabel":"Artisan — notes","notes":"<h2>Artisan</h2><p>Liste d’artisanat organique et mécanique : tissus, cuir, bois, matières organiques, pierres lumineuses, programmation et fonctionnement de machines. Une « machine » est ici un dispositif artificiel construit pour accomplir une fonction précise.</p>"}},"en":{"name":"Craftsman","system":{"name":"Craftsman","label":"Craftsman","notesLabel":"Craftsman — notes","notes":"<h2>Craftsman</h2><p>Organic and mechanical craft List: cloth, leather, wood, organic materials, luminous stones, programming, and operation of machines. A “machine” here is an artificial device constructed to perform a specific function.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Théurgie","Razak-Zinul (Base)"],"en":["Channeling Spell Lists","Razak-Zinul (Base)"]},"compendiumFolderKeyPath":["spell-lists-channeling","spell-lists-channeling-razak-zinul"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / MERP-RMSS v2.5","name":"Craftsman","listType":"Base","realms":"Channeling","profession":"Razak-zinul","notes":"<h2>Craftsman</h2><p>Organic and mechanical craft List: cloth, leather, wood, organic materials, luminous stones, programming, and operation of machines. A “machine” here is an artificial device constructed to perform a specific function.</p>","label":"Craftsman","notesLabel":"Craftsman — notes","spells":[{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Work Cloth","label":"MERP_RMU.RazakZinul.craftsman.spells.WorkCloth.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.WorkCloth.description","level":1,"description":"Allows flawless working of ordinary cloth with the necessary tools and materials; working time is halved.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Tissu","description":"Permet de travailler parfaitement le tissu ordinaire avec les outils et matériaux nécessaires ; le temps de travail est réduit de moitié."},"en":{"name":"Work Cloth","description":"Allows flawless working of ordinary cloth with the necessary tools and materials; working time is halved."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Work Leather","label":"MERP_RMU.RazakZinul.craftsman.spells.WorkLeather.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.WorkLeather.description","level":2,"description":"As Work Cloth, but for ordinary leather.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Cuir","description":"Comme Travail du Tissu, mais pour le cuir ordinaire."},"en":{"name":"Work Leather","description":"As Work Cloth, but for ordinary leather."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Work Wood","label":"MERP_RMU.RazakZinul.craftsman.spells.WorkWood.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.WorkWood.description","level":3,"description":"As Work Cloth, but for ordinary wood.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Bois","description":"Comme Travail du Tissu, mais pour le bois ordinaire."},"en":{"name":"Work Wood","description":"As Work Cloth, but for ordinary wood."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Operate I","label":"MERP_RMU.RazakZinul.craftsman.spells.OperateI.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.OperateI.description","level":4,"description":"Gives the caster a chance to operate a non-magical machine correctly even without full familiarity.","aoe":"1 machine","duration":"1 min/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Fonctionnement I","description":"Donne au lanceur une chance de faire fonctionner correctement une machine non magique même sans en connaître parfaitement l’usage."},"en":{"name":"Operate I","description":"Gives the caster a chance to operate a non-magical machine correctly even without full familiarity."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Work Organic","label":"MERP_RMU.RazakZinul.craftsman.spells.WorkOrganic.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.WorkOrganic.description","level":5,"description":"Allows the caster to work ordinary organic materials such as horn, bone, chitin, wax, feathers and hair.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail Organique","description":"Permet au lanceur de travailler des matières organiques ordinaires comme la corne, l’os, la chitine, la cire, les plumes et les cheveux."},"en":{"name":"Work Organic","description":"Allows the caster to work ordinary organic materials such as horn, bone, chitin, wax, feathers and hair."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Light Stone I","label":"MERP_RMU.RazakZinul.craftsman.spells.LightStoneI.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.LightStoneI.description","level":6,"description":"Creates a prepared stone that emits useful light as described by the source list.","aoe":"1 stone","duration":"24 hrs","range":"touch","spellType":"F","localizations":{"fr":{"name":"Pierre de Lumière I","description":"Crée une pierre préparée qui émet une lumière utile conformément à la liste d’origine."},"en":{"name":"Light Stone I","description":"Creates a prepared stone that emits useful light as described by the source list."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Program I","label":"MERP_RMU.RazakZinul.craftsman.spells.ProgramI.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.ProgramI.description","level":7,"description":"Allows a simple program or sequence to be set into a suitable machine for later operation.","aoe":"1 machine","duration":"24 hrs","range":"touch","spellType":"F","localizations":{"fr":{"name":"Programme I","description":"Permet d’inscrire dans une machine adaptée un programme ou une séquence simple destiné à une utilisation ultérieure."},"en":{"name":"Program I","description":"Allows a simple program or sequence to be set into a suitable machine for later operation."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Operate II","label":"MERP_RMU.RazakZinul.craftsman.spells.OperateII.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.OperateII.description","level":9,"description":"As Operate I, but with a higher chance of successful operation.","aoe":"1 machine","duration":"1 min/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Fonctionnement II","description":"Comme Fonctionnement I, mais avec une probabilité de réussite supérieure."},"en":{"name":"Operate II","description":"As Operate I, but with a higher chance of successful operation."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Light Stone II","label":"MERP_RMU.RazakZinul.craftsman.spells.LightStoneII.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.LightStoneII.description","level":11,"description":"As Light Stone I, with improved light output or endurance.","aoe":"1 stone","duration":"24 hrs","range":"touch","spellType":"F","localizations":{"fr":{"name":"Pierre de Lumière II","description":"Comme Pierre de Lumière I, mais avec une lumière plus intense ou une durée accrue."},"en":{"name":"Light Stone II","description":"As Light Stone I, with improved light output or endurance."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Program II","label":"MERP_RMU.RazakZinul.craftsman.spells.ProgramII.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.ProgramII.description","level":12,"description":"As Program I, but permits a more complex programmed sequence.","aoe":"1 machine","duration":"24 hrs","range":"touch","spellType":"F","localizations":{"fr":{"name":"Programme II","description":"Comme Programme I, mais permet une séquence programmée plus complexe."},"en":{"name":"Program II","description":"As Program I, but permits a more complex programmed sequence."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Operate III","label":"MERP_RMU.RazakZinul.craftsman.spells.OperateIII.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.OperateIII.description","level":14,"description":"As Operate I, but with a still higher chance of successful operation.","aoe":"1 machine","duration":"1 min/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Fonctionnement III","description":"Comme Fonctionnement I, mais avec une probabilité de réussite encore supérieure."},"en":{"name":"Operate III","description":"As Operate I, but with a still higher chance of successful operation."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Light Stone III","label":"MERP_RMU.RazakZinul.craftsman.spells.LightStoneIII.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.LightStoneIII.description","level":16,"description":"As Light Stone I, with the strongest normal effect on this list.","aoe":"1 stone","duration":"24 hrs","range":"touch","spellType":"F","localizations":{"fr":{"name":"Pierre de Lumière III","description":"Comme Pierre de Lumière I, avec l’effet normal le plus puissant de cette liste."},"en":{"name":"Light Stone III","description":"As Light Stone I, with the strongest normal effect on this list."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Work Magic Cloth","label":"MERP_RMU.RazakZinul.craftsman.spells.WorkMagicCloth.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.WorkMagicCloth.description","level":17,"description":"Allows flawless working of magical cloth with required tools and materials.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Tissu Magique","description":"Permet de travailler parfaitement le tissu magique avec les outils et matériaux requis."},"en":{"name":"Work Magic Cloth","description":"Allows flawless working of magical cloth with required tools and materials."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Work Magic Leather","label":"MERP_RMU.RazakZinul.craftsman.spells.WorkMagicLeather.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.WorkMagicLeather.description","level":18,"description":"Allows flawless working of magical leather with required tools and materials.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Cuir Magique","description":"Permet de travailler parfaitement le cuir magique avec les outils et matériaux requis."},"en":{"name":"Work Magic Leather","description":"Allows flawless working of magical leather with required tools and materials."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Work Magic Wood","label":"MERP_RMU.RazakZinul.craftsman.spells.WorkMagicWood.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.WorkMagicWood.description","level":19,"description":"Allows flawless working of magical wood with required tools and materials.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Bois Magique","description":"Permet de travailler parfaitement le bois magique avec les outils et matériaux requis."},"en":{"name":"Work Magic Wood","description":"Allows flawless working of magical wood with required tools and materials."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Work Magic Organic True","label":"MERP_RMU.RazakZinul.craftsman.spells.WorkMagicOrganicTrue.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.WorkMagicOrganicTrue.description","level":20,"description":"Allows the caster to work any magical organic material with required tools and materials.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail Organique Magique Véritable","description":"Permet au lanceur de travailler toute matière organique magique avec les outils et matériaux requis."},"en":{"name":"Work Magic Organic True","description":"Allows the caster to work any magical organic material with required tools and materials."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Operate IV","label":"MERP_RMU.RazakZinul.craftsman.spells.OperateIV.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.OperateIV.description","level":25,"description":"As Operate I, but the source gives a 90% chance of operating the machine.","aoe":"1 machine","duration":"1 min/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Fonctionnement IV","description":"Comme Fonctionnement I, mais la source indique 90 % de chances de faire fonctionner la machine."},"en":{"name":"Operate IV","description":"As Operate I, but the source gives a 90% chance of operating the machine."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Mass Operate","label":"MERP_RMU.RazakZinul.craftsman.spells.MassOperate.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.MassOperate.description","level":30,"description":"As Operate III, but affects all machines in the area of effect.","aoe":"varies","duration":"1 min/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Fonctionnement de Masse","description":"Comme Fonctionnement III, mais affecte toutes les machines de la zone d’effet."},"en":{"name":"Mass Operate","description":"As Operate III, but affects all machines in the area of effect."}}},{"spellList":"Craftsman","listType":"Base","profession":"Razak-zinul","name":"Perpetual Motion","label":"MERP_RMU.RazakZinul.craftsman.spells.PerpetualMotion.name","descriptionLabel":"MERP_RMU.RazakZinul.craftsman.spells.PerpetualMotion.description","level":50,"description":"Causes one non-magical mechanism to operate normally for the duration without an external motive force.","aoe":"1 machine","duration":"1 hr/lvl","range":"touch","spellType":"F","localizations":{"fr":{"name":"Mouvement Perpétuel","description":"Fait fonctionner normalement un mécanisme non magique pendant la durée du sort sans source motrice extérieure."},"en":{"name":"Perpetual Motion","description":"Causes one non-magical mechanism to operate normally for the duration without an external motive force."}}}]},"_id":"Mttvn3fkc6aa44vy"}
{"name":"Dwarven Inorganic Skills","type":"spell-list","img":"icons/magic/symbols/rune-sigil-horned-white-purple.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"razak-zinul-dwarven-inorganic-skills","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS/MERP","sourceBook":"MERP Character Creation Using RMSS/RMFRP v2.5","sourceList":"Dwarven Inorganic Skills","sourcePage":233,"merpRealm":"Channeling","merpCategory":"Profession","profession":"Razak-zinul","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"merp-rmss-spell-list-conversion","reference":"MERP/RMSS v2.5 pp. 233; Razak-zinul Base List"},"compendiumSourceKey":"razak-zinul-dwarven-inorganic-skills","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-channeling-razak-zinul","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Techniques Inorganiques Naines","system":{"name":"Techniques Inorganiques Naines","label":"Techniques Inorganiques Naines","notesLabel":"Techniques Inorganiques Naines — notes","notes":"<h2>Techniques Inorganiques Naines</h2><p>Travail magique de la pierre, des métaux et des alliages khazâds. Les bonus de matériau obtenus ne sont pas eux-mêmes magiques : d’autres Listes sont nécessaires pour créer un enchantement.</p>"}},"en":{"name":"Dwarven Inorganic Skills","system":{"name":"Dwarven Inorganic Skills","label":"Dwarven Inorganic Skills","notesLabel":"Dwarven Inorganic Skills — notes","notes":"<h2>Dwarven Inorganic Skills</h2><p>Magical working of stone, metals, and Khazâd alloys. The material bonuses obtained are not themselves magical: other Lists are required to create an enchantment.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Théurgie","Razak-Zinul (Base)"],"en":["Channeling Spell Lists","Razak-Zinul (Base)"]},"compendiumFolderKeyPath":["spell-lists-channeling","spell-lists-channeling-razak-zinul"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / MERP-RMSS v2.5","name":"Dwarven Inorganic Skills","listType":"Base","realms":"Channeling","profession":"Razak-zinul","notes":"<h2>Dwarven Inorganic Skills</h2><p>Magical working of stone, metals, and Khazâd alloys. The material bonuses obtained are not themselves magical: other Lists are required to create an enchantment.</p>","label":"Dwarven Inorganic Skills","notesLabel":"Dwarven Inorganic Skills — notes","spells":[{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Stone","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkStone.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkStone.description","level":1,"description":"Allows flawless working of non-magical stone with all required tools and materials present; working time is halved.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail de la Pierre","description":"Permet de travailler parfaitement la pierre non magique lorsque tous les outils et matériaux nécessaires sont disponibles ; le temps de travail est réduit de moitié."},"en":{"name":"Work Stone","description":"Allows flawless working of non-magical stone with all required tools and materials present; working time is halved."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Metal","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkMetal.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkMetal.description","level":2,"description":"As Work Stone, but for ordinary non-magical metals; Nornang is excluded.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Métal","description":"Comme Travail de la Pierre, mais pour les métaux ordinaires non magiques ; le Nornang est exclu."},"en":{"name":"Work Metal","description":"As Work Stone, but for ordinary non-magical metals; Nornang is excluded."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Alloy","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkAlloy.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkAlloy.description","level":3,"description":"As Work Stone, but for ordinary non-iron alloys such as brass, bronze and pewter.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail des Alliages","description":"Comme Travail de la Pierre, mais pour les alliages ordinaires sans fer, comme le laiton, le bronze et l’étain."},"en":{"name":"Work Alloy","description":"As Work Stone, but for ordinary non-iron alloys such as brass, bronze and pewter."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Nornang","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkNornang.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkNornang.description","level":4,"description":"As Work Stone, but permits the working of Nornang (hard iron).","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Nornang","description":"Comme Travail de la Pierre, mais permet de travailler le Nornang (fer dur)."},"en":{"name":"Work Nornang","description":"As Work Stone, but permits the working of Nornang (hard iron)."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Borang","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkBorang.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkBorang.description","level":5,"description":"As Work Stone, but permits the working of Borang (low-carbon steel).","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Borang","description":"Comme Travail de la Pierre, mais permet de travailler le Borang (acier à faible teneur en carbone)."},"en":{"name":"Work Borang","description":"As Work Stone, but permits the working of Borang (low-carbon steel)."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Make Alloy","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.MakeAlloy.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.MakeAlloy.description","level":6,"description":"Allows the caster to make ordinary alloys from available raw materials and equipment; it does not make steel from iron.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Fabriquer un Alliage","description":"Permet au lanceur de fabriquer des alliages ordinaires à partir des matières premières et de l’équipement disponibles ; ne permet pas de fabriquer de l’acier à partir de fer."},"en":{"name":"Make Alloy","description":"Allows the caster to make ordinary alloys from available raw materials and equipment; it does not make steel from iron."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Celebrang","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkCelebrang.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkCelebrang.description","level":7,"description":"As Work Stone, but permits the working of Celebrang/Arborang (high-carbon steel).","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Celebrang","description":"Comme Travail de la Pierre, mais permet de travailler le Celebrang/Arborang (acier à forte teneur en carbone)."},"en":{"name":"Work Celebrang","description":"As Work Stone, but permits the working of Celebrang/Arborang (high-carbon steel)."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Make Steel","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.MakeSteel.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.MakeSteel.description","level":8,"description":"Allows the caster to make steel from iron, limited by available materials and equipment.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Fabriquer de l’Acier","description":"Permet au lanceur de fabriquer de l’acier à partir de fer, dans les limites des matériaux et de l’équipement disponibles."},"en":{"name":"Make Steel","description":"Allows the caster to make steel from iron, limited by available materials and equipment."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Ardarcer","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkArdarcer.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkArdarcer.description","level":9,"description":"As Work Stone, but permits the working of Ardarcer.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail de l’Ardarcer","description":"Comme Travail de la Pierre, mais permet de travailler l’Ardarcer."},"en":{"name":"Work Ardarcer","description":"As Work Stone, but permits the working of Ardarcer."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Tasarang","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkTasarang.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkTasarang.description","level":10,"description":"As Work Stone, but permits the working of the enchanted metal Tasarang.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Tasarang","description":"Comme Travail de la Pierre, mais permet de travailler le métal enchanté Tasarang."},"en":{"name":"Work Tasarang","description":"As Work Stone, but permits the working of the enchanted metal Tasarang."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Gemstone","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkGemstone.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkGemstone.description","level":11,"description":"As Work Stone, but permits flawless working of non-magical gemstones.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail des Gemmes","description":"Comme Travail de la Pierre, mais permet de travailler parfaitement les gemmes non magiques."},"en":{"name":"Work Gemstone","description":"As Work Stone, but permits flawless working of non-magical gemstones."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Ogamur","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkOgamur.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkOgamur.description","level":12,"description":"As Work Stone, but permits the working of the enchanted metal Ogamur.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail de l’Ogamur","description":"Comme Travail de la Pierre, mais permet de travailler le métal enchanté Ogamur."},"en":{"name":"Work Ogamur","description":"As Work Stone, but permits the working of the enchanted metal Ogamur."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Mithril","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkMithril.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkMithril.description","level":15,"description":"As Work Stone, but permits the working of Mithril; items made from it gain the material bonus described by the source.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Mithril","description":"Comme Travail de la Pierre, mais permet de travailler le Mithril ; les objets qui en sont faits gagnent le bonus de matériau décrit dans la source."},"en":{"name":"Work Mithril","description":"As Work Stone, but permits the working of Mithril; items made from it gain the material bonus described by the source."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Ithilnaur","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkIthilnaur.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkIthilnaur.description","level":16,"description":"As Work Stone, but permits the working of Ithilnaur.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail de l’Ithilnaur","description":"Comme Travail de la Pierre, mais permet de travailler l’Ithilnaur."},"en":{"name":"Work Ithilnaur","description":"As Work Stone, but permits the working of Ithilnaur."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Ithildin","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkIthildin.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkIthildin.description","level":17,"description":"As Work Stone, but permits the working of Ithildin.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail de l’Ithildin","description":"Comme Travail de la Pierre, mais permet de travailler l’Ithildin."},"en":{"name":"Work Ithildin","description":"As Work Stone, but permits the working of Ithildin."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Laen","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkLaen.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkLaen.description","level":20,"description":"As Work Stone, but permits the working of Laen.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail du Laen","description":"Comme Travail de la Pierre, mais permet de travailler le Laen."},"en":{"name":"Work Laen","description":"As Work Stone, but permits the working of Laen."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Work Eog","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkEog.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.WorkEog.description","level":25,"description":"As Work Stone, but permits the working of Eog.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Travail de l’Eog","description":"Comme Travail de la Pierre, mais permet de travailler l’Eog."},"en":{"name":"Work Eog","description":"As Work Stone, but permits the working of Eog."}}},{"spellList":"Dwarven Inorganic Skills","listType":"Base","profession":"Razak-zinul","name":"Make/Work","label":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.MakeWork.name","descriptionLabel":"MERP_RMU.RazakZinul.dwarveninorganicskills.spells.MakeWork.description","level":50,"description":"Allows the caster to make and work any metal, alloy or inorganic material for which the necessary materials and tools are available.","aoe":"caster","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Fabriquer/Travailler","description":"Permet au lanceur de fabriquer et de travailler tout métal, alliage ou matériau inorganique pour lequel il dispose des matériaux et outils nécessaires."},"en":{"name":"Make/Work","description":"Allows the caster to make and work any metal, alloy or inorganic material for which the necessary materials and tools are available."}}}]},"_id":"tvRgIKBClbRumKPU"}
{"name":"Loremaster","type":"spell-list","img":"icons/magic/symbols/rune-sigil-horned-white-purple.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"razak-zinul-loremaster","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS/MERP","sourceBook":"MERP Character Creation Using RMSS/RMFRP v2.5","sourceList":"Loremaster","sourcePage":240,"merpRealm":"Channeling","merpCategory":"Profession","profession":"Razak-zinul","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"merp-rmss-spell-list-conversion","reference":"MERP/RMSS v2.5 pp. 240; Razak-zinul Base List"},"compendiumSourceKey":"razak-zinul-loremaster","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-channeling-razak-zinul","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Maître du Savoir","system":{"name":"Maître du Savoir","label":"Maître du Savoir","notesLabel":"Maître du Savoir — notes","notes":"<h2>Maître du Savoir</h2><p>Analyse des objets et machines, identification de leurs origines et capacités, et création d’enchantements généraux. La restriction de réanalyse après gain de niveau de l’ancienne Item Analysis reste applicable lorsque le MJ utilise cette règle source.</p>"}},"en":{"name":"Loremaster","system":{"name":"Loremaster","label":"Loremaster","notesLabel":"Loremaster — notes","notes":"<h2>Loremaster</h2><p>Analysis of objects and machines, identification of their origins and capabilities, and creation of general enchantments. The old Item Analysis restriction preventing another analysis until a level is gained remains applicable when the GM uses that source rule.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Théurgie","Razak-Zinul (Base)"],"en":["Channeling Spell Lists","Razak-Zinul (Base)"]},"compendiumFolderKeyPath":["spell-lists-channeling","spell-lists-channeling-razak-zinul"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / MERP-RMSS v2.5","name":"Loremaster","listType":"Base","realms":"Channeling","profession":"Razak-zinul","notes":"<h2>Loremaster</h2><p>Analysis of objects and machines, identification of their origins and capabilities, and creation of general enchantments. The old Item Analysis restriction preventing another analysis until a level is gained remains applicable when the GM uses that source rule.</p>","label":"Loremaster","notesLabel":"Loremaster — notes","spells":[{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Detect Power","label":"MERP_RMU.RazakZinul.loremaster.spells.DetectPower.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.DetectPower.description","level":1,"description":"Detects whether an object contains power, without identifying its realm or strength.","aoe":"1 object","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Détection de la Puissance","description":"Détecte si un objet contient de la puissance, sans en identifier le royaume ni l’intensité."},"en":{"name":"Detect Power","description":"Detects whether an object contains power, without identifying its realm or strength."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Item Lore","label":"MERP_RMU.RazakZinul.loremaster.spells.ItemLore.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.ItemLore.description","level":2,"description":"Gives a basic idea of an item’s purpose, if any.","aoe":"1 object","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Connaissance des Objets","description":"Donne une idée générale de la fonction d’un objet, s’il en possède une."},"en":{"name":"Item Lore","description":"Gives a basic idea of an item’s purpose, if any."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Detect Curse","label":"MERP_RMU.RazakZinul.loremaster.spells.DetectCurse.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.DetectCurse.description","level":3,"description":"Detects whether an item is cursed.","aoe":"1 object","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Détection de Malédiction","description":"Détecte si un objet est maudit."},"en":{"name":"Detect Curse","description":"Detects whether an item is cursed."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Item Analysis I","label":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisI.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisI.description","level":4,"description":"Provides a 10% chance per ability to determine the enchanted abilities of one item.","aoe":"1 object","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Analyse d’Objet I","description":"Donne 10 % de chances par capacité de déterminer chacune des capacités enchantées d’un objet."},"en":{"name":"Item Analysis I","description":"Provides a 10% chance per ability to determine the enchanted abilities of one item."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"General I","label":"MERP_RMU.RazakZinul.loremaster.spells.GeneralI.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.GeneralI.description","level":6,"description":"Allows the caster to enchant a general-purpose magic item with a Class I bonus.","aoe":"self","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Général I","description":"Permet au lanceur d’enchanter un objet magique à usage général avec un bonus de Classe I."},"en":{"name":"General I","description":"Allows the caster to enchant a general-purpose magic item with a Class I bonus."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Machine Lore","label":"MERP_RMU.RazakZinul.loremaster.spells.MachineLore.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.MachineLore.description","level":7,"description":"Analyzes one machine, giving its purpose and operating procedures and a bonus when operating it.","aoe":"1 machine","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Connaissance des Machines","description":"Analyse une machine, révélant sa fonction et ses procédures d’utilisation et conférant un bonus pour la faire fonctionner."},"en":{"name":"Machine Lore","description":"Analyzes one machine, giving its purpose and operating procedures and a bonus when operating it."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Item Analysis II","label":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisII.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisII.description","level":8,"description":"As Item Analysis I, but with a 20% chance per ability.","aoe":"1 object","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Analyse d’Objet II","description":"Comme Analyse d’Objet I, mais avec 20 % de chances par capacité."},"en":{"name":"Item Analysis II","description":"As Item Analysis I, but with a 20% chance per ability."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Origins","label":"MERP_RMU.RazakZinul.loremaster.spells.Origins.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.Origins.description","level":9,"description":"Reveals the item’s area of origin, creator race, and approximate date of manufacture.","aoe":"1 object","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Origines","description":"Révèle la région d’origine de l’objet, la race de son créateur et sa date approximative de fabrication."},"en":{"name":"Origins","description":"Reveals the item’s area of origin, creator race, and approximate date of manufacture."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"General II","label":"MERP_RMU.RazakZinul.loremaster.spells.GeneralII.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.GeneralII.description","level":10,"description":"As General I, but creates a stronger general enchantment.","aoe":"self","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Général II","description":"Comme Général I, mais crée un enchantement général plus puissant."},"en":{"name":"General II","description":"As General I, but creates a stronger general enchantment."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Item Analysis III","label":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisIII.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisIII.description","level":12,"description":"As Item Analysis I, with a greater chance to identify each ability.","aoe":"1 object","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Analyse d’Objet III","description":"Comme Analyse d’Objet I, mais avec une chance supérieure d’identifier chaque capacité."},"en":{"name":"Item Analysis III","description":"As Item Analysis I, with a greater chance to identify each ability."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Mechanition Lore","label":"MERP_RMU.RazakZinul.loremaster.spells.MechanitionLore.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.MechanitionLore.description","level":13,"description":"Provides advanced knowledge of a machine’s construction, operation and likely faults.","aoe":"1 machine","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Connaissance des Mécanismes","description":"Fournit une connaissance avancée de la construction, du fonctionnement et des pannes probables d’une machine."},"en":{"name":"Mechanition Lore","description":"Provides advanced knowledge of a machine’s construction, operation and likely faults."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"General III","label":"MERP_RMU.RazakZinul.loremaster.spells.GeneralIII.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.GeneralIII.description","level":15,"description":"As General I, but creates a stronger general enchantment.","aoe":"self","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Général III","description":"Comme Général I, mais crée un enchantement général plus puissant."},"en":{"name":"General III","description":"As General I, but creates a stronger general enchantment."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Item Analysis IV","label":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisIV.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisIV.description","level":16,"description":"As Item Analysis I, with a greater chance to identify each ability.","aoe":"1 object","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Analyse d’Objet IV","description":"Comme Analyse d’Objet I, mais avec une chance supérieure d’identifier chaque capacité."},"en":{"name":"Item Analysis IV","description":"As Item Analysis I, with a greater chance to identify each ability."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Engineering Lore","label":"MERP_RMU.RazakZinul.loremaster.spells.EngineeringLore.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.EngineeringLore.description","level":17,"description":"Gives the caster insight into engineering principles relevant to the examined construction or mechanism.","aoe":"caster","duration":"--","range":"self","spellType":"I","localizations":{"fr":{"name":"Connaissance de l’Ingénierie","description":"Donne au lanceur une compréhension des principes d’ingénierie pertinents pour la construction ou le mécanisme examiné."},"en":{"name":"Engineering Lore","description":"Gives the caster insight into engineering principles relevant to the examined construction or mechanism."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Item Analysis V","label":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisV.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisV.description","level":20,"description":"As Item Analysis I, with a greater chance to identify each ability.","aoe":"1 object","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Analyse d’Objet V","description":"Comme Analyse d’Objet I, mais avec une chance supérieure d’identifier chaque capacité."},"en":{"name":"Item Analysis V","description":"As Item Analysis I, with a greater chance to identify each ability."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Origins True","label":"MERP_RMU.RazakZinul.loremaster.spells.OriginsTrue.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.OriginsTrue.description","level":25,"description":"Reveals substantially more precise information about the origins and history of one item.","aoe":"1 object","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Origines Véritables","description":"Révèle des informations nettement plus précises sur l’origine et l’histoire d’un objet."},"en":{"name":"Origins True","description":"Reveals substantially more precise information about the origins and history of one item."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Item Analysis VII","label":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisVII.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisVII.description","level":30,"description":"As Item Analysis I, with a very high chance to identify each enchanted ability.","aoe":"1 object","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Analyse d’Objet VII","description":"Comme Analyse d’Objet I, mais avec une très forte chance d’identifier chaque capacité enchantée."},"en":{"name":"Item Analysis VII","description":"As Item Analysis I, with a very high chance to identify each enchanted ability."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"General IV","label":"MERP_RMU.RazakZinul.loremaster.spells.GeneralIV.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.GeneralIV.description","level":35,"description":"As General I, but creates the strongest normal general enchantment on this list.","aoe":"self","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Général IV","description":"Comme Général I, mais crée l’enchantement général normal le plus puissant de cette liste."},"en":{"name":"General IV","description":"As General I, but creates the strongest normal general enchantment on this list."}}},{"spellList":"Loremaster","listType":"Base","profession":"Razak-zinul","name":"Item Analysis True","label":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisTrue.name","descriptionLabel":"MERP_RMU.RazakZinul.loremaster.spells.ItemAnalysisTrue.description","level":50,"description":"Provides the list’s most complete magical analysis of one item.","aoe":"1 object","duration":"--","range":"touch","spellType":"I","localizations":{"fr":{"name":"Analyse d’Objet Véritable","description":"Fournit l’analyse magique la plus complète de cette liste pour un objet."},"en":{"name":"Item Analysis True","description":"Provides the list’s most complete magical analysis of one item."}}}]},"_id":"uKdtWT2EzhncvWrL"}
{"name":"Other Realm Imbedding","type":"spell-list","img":"icons/magic/symbols/rune-sigil-horned-white-purple.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"razak-zinul-other-realm-imbedding","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS/MERP","sourceBook":"Alchemy Companion","sourceList":"Other Realm Imbedding","sourcePage":121,"merpRealm":"Channeling","merpCategory":"Profession","profession":"Razak-zinul","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"alchemy-companion-list-adaptation","reference":"Alchemy Companion pp.120–121; adapted for Razak-zinul Channeling tradition"},"compendiumSourceKey":"razak-zinul-other-realm-imbedding","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-channeling-razak-zinul","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Imprégnation d'un Autre Royaume","system":{"name":"Imprégnation d'un Autre Royaume","label":"Imprégnation d'un Autre Royaume","notesLabel":"Imprégnation d'un Autre Royaume — notes","notes":"<h2>Imprégnation d'un Autre Royaume</h2><p>Liste d’imprégnation du Razak-Zinul adaptée depuis les listes d’Alchimiste du <em>Alchemy Companion</em>. Elle est convertie au Royaume de Canalisation et utilise les inscriptions/runes khazâdes comme clef d’activation.</p>"}},"en":{"name":"Other Realm Imbedding","system":{"name":"Other Realm Imbedding","label":"Other Realm Imbedding","notesLabel":"Other Realm Imbedding — notes","notes":"<h2>Other Realm Imbedding</h2><p>Razak-Zinul Imbedding List adapted from the Alchemist Lists in the <em>Alchemy Companion</em>. It is converted to the Channeling Realm and uses Khazâd inscriptions/runes as its activation key.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Théurgie","Razak-Zinul (Base)"],"en":["Channeling Spell Lists","Razak-Zinul (Base)"]},"compendiumFolderKeyPath":["spell-lists-channeling","spell-lists-channeling-razak-zinul"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / Alchemy Companion","name":"Other Realm Imbedding","listType":"Base","realms":"Channeling","profession":"Razak-zinul","notes":"<h2>Other Realm Imbedding</h2><p>Razak-Zinul Imbedding List adapted from the Alchemist Lists in the <em>Alchemy Companion</em>. It is converted to the Channeling Realm and uses Khazâd inscriptions/runes as its activation key.</p>","label":"Other Realm Imbedding","notesLabel":"Other Realm Imbedding — notes","spells":[{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Razak-zinul","name":"Research","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.Research.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.Research.description","level":1,"description":"Researches special imbedding spells for item creation; alternatively grants +50 to appropriate Spell Research and/or Item Creation rolls concerning Mentalism or Essence imbedding.","aoe":"self","duration":"24 hours","range":"self","spellType":"I","localizations":{"fr":{"name":"Recherche","description":"Recherche des sorts d’imprégnation spéciaux destinés à la création d’objets ; peut également conférer +50 aux jets appropriés de Recherche de Sorts et/ou de Création d’Objets concernant l’imprégnation du Mentalisme ou de l’Essence."},"en":{"name":"Research","description":"Researches special imbedding spells for item creation; alternatively grants +50 to appropriate Spell Research and/or Item Creation rolls concerning Mentalism or Essence imbedding."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Razak-zinul","name":"Imbed I","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ImbedI.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ImbedI.description","level":3,"description":"Imbeds one 1st-level Mentalism or Essence spell in an item or potion. The caster must have access to the spell being imbedded.","aoe":"1 item","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Imprégnation I","description":"Imprègne dans un objet ou une potion un sort de Mentalisme ou d’Essence de niveau 1. Le lanceur doit avoir accès au sort à imprégner."},"en":{"name":"Imbed I","description":"Imbeds one 1st-level Mentalism or Essence spell in an item or potion. The caster must have access to the spell being imbedded."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Razak-zinul","name":"Charge Wand","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ChargeWand.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ChargeWand.description","level":5,"description":"Charges a Mentalism or Essence wand when the caster has access to the appropriate spell.","aoe":"1 wand","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Charger une Baguette","description":"Charge une baguette de Mentalisme ou d’Essence lorsque le lanceur a accès au sort approprié."},"en":{"name":"Charge Wand","description":"Charges a Mentalism or Essence wand when the caster has access to the appropriate spell."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Razak-zinul","name":"Imbed II","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ImbedII.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ImbedII.description","level":6,"description":"As Imbed I, but may imbed spells through 2nd level.","aoe":"1 item","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Imprégnation II","description":"Comme Imprégnation I, mais permet d’imprégner des sorts jusqu’au niveau 2."},"en":{"name":"Imbed II","description":"As Imbed I, but may imbed spells through 2nd level."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Razak-zinul","name":"Daily I","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.DailyI.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.DailyI.description","level":7,"description":"An imbedded 1st-level spell may be used once per day.","aoe":"1 item","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Quotidien I","description":"Un sort imprégné de niveau 1 peut être utilisé une fois par jour."},"en":{"name":"Daily I","description":"An imbedded 1st-level spell may be used once per day."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Razak-zinul","name":"Imbed III","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ImbedIII.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ImbedIII.description","level":9,"description":"As Imbed I, but may imbed spells through 3rd level.","aoe":"1 item","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Imprégnation III","description":"Comme Imprégnation I, mais permet d’imprégner des sorts jusqu’au niveau 3."},"en":{"name":"Imbed III","description":"As Imbed I, but may imbed spells through 3rd level."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Razak-zinul","name":"Charge Rod","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ChargeRod.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ChargeRod.description","level":10,"description":"As Charge Wand, but charges a rod.","aoe":"1 rod","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Charger un Sceptre","description":"Comme Charger une Baguette, mais charge un sceptre."},"en":{"name":"Charge Rod","description":"As Charge Wand, but charges a rod."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Razak-zinul","name":"Daily III","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.DailyIII.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.DailyIII.description","level":11,"description":"Creates a daily item using spells through 3rd level; lower-level spells may receive more uses per day.","aoe":"1 item","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Quotidien III","description":"Crée un objet à usage quotidien utilisant des sorts jusqu’au niveau 3 ; les sorts de niveau inférieur peuvent bénéficier d’un plus grand nombre d’utilisations par jour."},"en":{"name":"Daily III","description":"Creates a daily item using spells through 3rd level; lower-level spells may receive more uses per day."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Razak-zinul","name":"Imbed IV","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ImbedIV.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ImbedIV.description","level":12,"description":"As Imbed I, but may imbed spells through 4th level.","aoe":"1 item","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Imprégnation IV","description":"Comme Imprégnation I, mais permet d’imprégner des sorts jusqu’au niveau 4."},"en":{"name":"Imbed IV","description":"As Imbed I, but may imbed spells through 4th level."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Razak-zinul","name":"Imbed V","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ImbedV.name","descriptionLabel":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.ImbedV.description","level":14,"description":"As Imbed I, but may imbed spells through 5th level.","aoe":"1 item","duration":"24 hours","range":"self","spellType":"F","localizations":{"fr":{"name":"Imprégnation V","description":"Comme Imprégnation I, mais permet d’imprégner des sorts jusqu’au niveau 5."},"en":{"name":"Imbed V","description":"As Imbed I, but may imbed spells through 5th level."}}},{"spellList":"Other Realm Imbedding","listType":"Base","profession":"Razak-zinul","name":"Daily V","label":"MERP_RMU.RazakZinul.otherrealmimbedding.spells.DailyV.name","descriptionLab