l.symbols.spells.BypassSymbolXI.description","level":19,"description":"As Bypass Symbol I, but works against stronger symbols.","aoe":"1 symbol","duration":"1 min/lvl","range":"50'","spellType":"F","localizations":{"fr":{"name":"Contournement de Symbole XI","description":"Comme Contournement de Symbole I, mais fonctionne contre des Symboles plus puissants."},"en":{"name":"Bypass Symbol XI","description":"As Bypass Symbol I, but works against stronger symbols."}}},{"spellList":"Symbols","listType":"Base","profession":"Razak-zinul","name":"Unsymbol XI","label":"MERP_RMU.RazakZinul.symbols.spells.UnsymbolXI.name","descriptionLabel":"MERP_RMU.RazakZinul.symbols.spells.UnsymbolXI.description","level":20,"description":"As Unsymbol I, but can remove a stronger symbol.","aoe":"1 symbol","duration":"P","range":"10'","spellType":"F","localizations":{"fr":{"name":"Dissipation de Symbole XI","description":"Comme Dissipation de Symbole I, mais peut supprimer un Symbole plus puissant."},"en":{"name":"Unsymbol XI","description":"As Unsymbol I, but can remove a stronger symbol."}}},{"spellList":"Symbols","listType":"Base","profession":"Razak-zinul","name":"Symbol XI","label":"MERP_RMU.RazakZinul.symbols.spells.SymbolXI.name","descriptionLabel":"MERP_RMU.RazakZinul.symbols.spells.SymbolXI.description","level":25,"description":"As Symbol I, but can hold a still higher-level spell.","aoe":"varies","duration":"P","range":"10'","spellType":"U","localizations":{"fr":{"name":"Symbole XI","description":"Comme Symbole I, mais peut contenir un sort d’un niveau encore supérieur."},"en":{"name":"Symbol XI","description":"As Symbol I, but can hold a still higher-level spell."}}},{"spellList":"Symbols","listType":"Base","profession":"Razak-zinul","name":"Unsymbol True","label":"MERP_RMU.RazakZinul.symbols.spells.UnsymbolTrue.name","descriptionLabel":"MERP_RMU.RazakZinul.symbols.spells.UnsymbolTrue.description","level":30,"description":"Removes symbols of any capacity allowed by this list, subject to the symbol’s resistance.","aoe":"1 symbol","duration":"P","range":"10'","spellType":"F","localizations":{"fr":{"name":"Dissipation de Symbole Véritable","description":"Supprime les Symboles de toute capacité permise par cette liste, sous réserve de leur résistance."},"en":{"name":"Unsymbol True","description":"Removes symbols of any capacity allowed by this list, subject to the symbol’s resistance."}}},{"spellList":"Symbols","listType":"Base","profession":"Razak-zinul","name":"Symbol True","label":"MERP_RMU.RazakZinul.symbols.spells.SymbolTrue.name","descriptionLabel":"MERP_RMU.RazakZinul.symbols.spells.SymbolTrue.description","level":50,"description":"Creates the ultimate symbol available on this list.","aoe":"varies","duration":"P","range":"10'","spellType":"U","localizations":{"fr":{"name":"Symbole Véritable","description":"Crée le Symbole ultime disponible sur cette liste."},"en":{"name":"Symbol True","description":"Creates the ultimate symbol available on this list."}}}]},"_id":"3atkIrtU4WlEPBzx"}
{"name":"Wards","type":"spell-list","img":"icons/magic/symbols/rune-sigil-horned-white-purple.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"razak-zinul-wards","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS/MERP","sourceBook":"MERP Character Creation Using RMSS/RMFRP v2.5","sourceList":"Wards","sourcePage":236,"merpRealm":"Channeling","merpCategory":"Profession","profession":"Razak-zinul","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"merp-rmss-spell-list-conversion","reference":"MERP/RMSS v2.5 pp. 236; Razak-zinul Base List"},"compendiumSourceKey":"razak-zinul-wards","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-channeling-razak-zinul","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Gardes","system":{"name":"Gardes","label":"Gardes","notesLabel":"Gardes — notes","notes":"<h2>Gardes</h2><p>Les Wards sont des inscriptions magiques placées sur un objet. Les sorts au-dessus du 3e niveau créent des protections inscrites ; déplacer l’objet pendant qu’un ward est actif annule normalement le ward.</p>"}},"en":{"name":"Wards","system":{"name":"Wards","label":"Wards","notesLabel":"Wards — notes","notes":"<h2>Wards</h2><p>Wards are magical inscriptions placed on an object. Spells above 3rd level create inscribed protections; moving the object while a ward is active normally cancels the ward.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Théurgie","Razak-Zinul (Base)"],"en":["Channeling Spell Lists","Razak-Zinul (Base)"]},"compendiumFolderKeyPath":["spell-lists-channeling","spell-lists-channeling-razak-zinul"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / MERP-RMSS v2.5","name":"Wards","listType":"Base","realms":"Channeling","profession":"Razak-zinul","notes":"<h2>Wards</h2><p>Wards are magical inscriptions placed on an object. Spells above 3rd level create inscribed protections; moving the object while a ward is active normally cancels the ward.</p>","label":"Wards","notesLabel":"Wards — notes","spells":[{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Detect Ward","label":"MERP_RMU.RazakZinul.wards.spells.DetectWard.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.DetectWard.description","level":1,"description":"Detects an active ward in the examined area; caster may examine a different area each round.","aoe":"5' R","duration":"1 min/lvl (C)","range":"50'","spellType":"U","localizations":{"fr":{"name":"Détection de Garde","description":"Détecte une Garde active dans la zone examinée ; le lanceur peut examiner une zone différente à chaque round."},"en":{"name":"Detect Ward","description":"Detects an active ward in the examined area; caster may examine a different area each round."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Ward Lore","label":"MERP_RMU.RazakZinul.wards.spells.WardLore.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.WardLore.description","level":2,"description":"Reveals the nature of one target ward, including what it protects against or prohibits.","aoe":"1 ward","duration":"--","range":"100'","spellType":"I","localizations":{"fr":{"name":"Connaissance des Gardes","description":"Révèle la nature d’une Garde ciblée, notamment ce contre quoi elle protège ou ce qu’elle interdit."},"en":{"name":"Ward Lore","description":"Reveals the nature of one target ward, including what it protects against or prohibits."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Bypass Ward","label":"MERP_RMU.RazakZinul.wards.spells.BypassWard.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.BypassWard.description","level":3,"description":"Designates a target who is immune to one of the caster’s wards for the duration.","aoe":"1 target","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Contournement de Garde","description":"Désigne une cible immunisée à l’une des Gardes du lanceur pendant la durée du sort."},"en":{"name":"Bypass Ward","description":"Designates a target who is immune to one of the caster’s wards for the duration."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Sense Ward I","label":"MERP_RMU.RazakZinul.wards.spells.SenseWardI.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.SenseWardI.description","level":4,"description":"Creates a ward that blocks one specified sense through its area unless resisted.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde des Sens I","description":"Crée une Garde qui bloque un sens spécifié à travers sa zone, sauf si elle est résistée."},"en":{"name":"Sense Ward I","description":"Creates a ward that blocks one specified sense through its area unless resisted."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Animal Ward","label":"MERP_RMU.RazakZinul.wards.spells.AnimalWard.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.AnimalWard.description","level":5,"description":"Prevents animals from willingly entering the warded area unless they resist.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde contre les Animaux","description":"Empêche les animaux d’entrer volontairement dans la zone gardée à moins qu’ils ne résistent."},"en":{"name":"Animal Ward","description":"Prevents animals from willingly entering the warded area unless they resist."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Alarm Ward I","label":"MERP_RMU.RazakZinul.wards.spells.AlarmWardI.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.AlarmWardI.description","level":6,"description":"Creates a ward that sounds a silent or audible alarm when specified circumstances occur.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde d’Alarme I","description":"Crée une Garde qui déclenche une alarme silencieuse ou audible lorsque les circonstances spécifiées surviennent."},"en":{"name":"Alarm Ward I","description":"Creates a ward that sounds a silent or audible alarm when specified circumstances occur."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Spell Ward I","label":"MERP_RMU.RazakZinul.wards.spells.SpellWardI.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.SpellWardI.description","level":7,"description":"Creates a ward that prevents one specified spell (and versions of it) from functioning through the area if the ward prevails.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde contre les Sorts I","description":"Crée une Garde empêchant un sort déterminé, ainsi que ses variantes, de fonctionner à travers la zone si la Garde l’emporte."},"en":{"name":"Spell Ward I","description":"Creates a ward that prevents one specified spell (and versions of it) from functioning through the area if the ward prevails."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Sense Ward II","label":"MERP_RMU.RazakZinul.wards.spells.SenseWardII.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.SenseWardII.description","level":8,"description":"As Sense Ward I, but blocks two senses.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde des Sens II","description":"Comme Garde des Sens I, mais bloque deux sens."},"en":{"name":"Sense Ward II","description":"As Sense Ward I, but blocks two senses."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Spell Ward II","label":"MERP_RMU.RazakZinul.wards.spells.SpellWardII.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.SpellWardII.description","level":9,"description":"As Spell Ward I, but may prevent two different spells.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde contre les Sorts II","description":"Comme Garde contre les Sorts I, mais peut empêcher deux sorts différents."},"en":{"name":"Spell Ward II","description":"As Spell Ward I, but may prevent two different spells."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Scrying Ward I","label":"MERP_RMU.RazakZinul.wards.spells.ScryingWardI.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.ScryingWardI.description","level":10,"description":"Creates a ward against magical scrying through the protected area.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde contre la Divination I","description":"Crée une Garde contre la divination magique à travers la zone protégée."},"en":{"name":"Scrying Ward I","description":"Creates a ward against magical scrying through the protected area."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Spell Ward III","label":"MERP_RMU.RazakZinul.wards.spells.SpellWardIII.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.SpellWardIII.description","level":11,"description":"As Spell Ward I, but may prevent three different spells.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde contre les Sorts III","description":"Comme Garde contre les Sorts I, mais peut empêcher trois sorts différents."},"en":{"name":"Spell Ward III","description":"As Spell Ward I, but may prevent three different spells."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Sense Ward III","label":"MERP_RMU.RazakZinul.wards.spells.SenseWardIII.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.SenseWardIII.description","level":12,"description":"As Sense Ward I, but blocks three senses.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde des Sens III","description":"Comme Garde des Sens I, mais bloque trois sens."},"en":{"name":"Sense Ward III","description":"As Sense Ward I, but blocks three senses."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Alarm Ward II","label":"MERP_RMU.RazakZinul.wards.spells.AlarmWardII.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.AlarmWardII.description","level":13,"description":"As Alarm Ward I, with a larger area.","aoe":"10' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde d’Alarme II","description":"Comme Garde d’Alarme I, mais avec une zone plus vaste."},"en":{"name":"Alarm Ward II","description":"As Alarm Ward I, with a larger area."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Undead Ward","label":"MERP_RMU.RazakZinul.wards.spells.UndeadWard.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.UndeadWard.description","level":14,"description":"Prevents undead from willingly entering the warded area unless they resist.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde contre les Morts-vivants","description":"Empêche les morts-vivants d’entrer volontairement dans la zone gardée à moins qu’ils ne résistent."},"en":{"name":"Undead Ward","description":"Prevents undead from willingly entering the warded area unless they resist."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Spell Ward IV","label":"MERP_RMU.RazakZinul.wards.spells.SpellWardIV.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.SpellWardIV.description","level":15,"description":"As Spell Ward I, but may prevent four different spells.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde contre les Sorts IV","description":"Comme Garde contre les Sorts I, mais peut empêcher quatre sorts différents."},"en":{"name":"Spell Ward IV","description":"As Spell Ward I, but may prevent four different spells."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Sense Ward IV","label":"MERP_RMU.RazakZinul.wards.spells.SenseWardIV.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.SenseWardIV.description","level":16,"description":"As Sense Ward I, but blocks four senses.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde des Sens IV","description":"Comme Garde des Sens I, mais bloque quatre sens."},"en":{"name":"Sense Ward IV","description":"As Sense Ward I, but blocks four senses."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Spell Ward V","label":"MERP_RMU.RazakZinul.wards.spells.SpellWardV.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.SpellWardV.description","level":17,"description":"As Spell Ward I, but may prevent five different spells.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde contre les Sorts V","description":"Comme Garde contre les Sorts I, mais peut empêcher cinq sorts différents."},"en":{"name":"Spell Ward V","description":"As Spell Ward I, but may prevent five different spells."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Scrying Ward II","label":"MERP_RMU.RazakZinul.wards.spells.ScryingWardII.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.ScryingWardII.description","level":18,"description":"As Scrying Ward I, with a larger area.","aoe":"10' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde contre la Divination II","description":"Comme Garde contre la Divination I, mais avec une zone plus vaste."},"en":{"name":"Scrying Ward II","description":"As Scrying Ward I, with a larger area."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Spell Ward VII","label":"MERP_RMU.RazakZinul.wards.spells.SpellWardVII.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.SpellWardVII.description","level":20,"description":"As Spell Ward I, but may prevent seven different spells.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde contre les Sorts VII","description":"Comme Garde contre les Sorts I, mais peut empêcher sept sorts différents."},"en":{"name":"Spell Ward VII","description":"As Spell Ward I, but may prevent seven different spells."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Alarm Ward III","label":"MERP_RMU.RazakZinul.wards.spells.AlarmWardIII.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.AlarmWardIII.description","level":25,"description":"As Alarm Ward I, with a larger area.","aoe":"15' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde d’Alarme III","description":"Comme Garde d’Alarme I, mais avec une zone plus vaste."},"en":{"name":"Alarm Ward III","description":"As Alarm Ward I, with a larger area."}}},{"spellList":"Wards","listType":"Base","profession":"Razak-zinul","name":"Lord Spell Ward","label":"MERP_RMU.RazakZinul.wards.spells.LordSpellWard.name","descriptionLabel":"MERP_RMU.RazakZinul.wards.spells.LordSpellWard.description","level":50,"description":"As Spell Ward I, but may prevent up to twenty different spells.","aoe":"5' R/lvl","duration":"1 hr/lvl","range":"touch","spellType":"U","localizations":{"fr":{"name":"Garde Seigneur contre les Sorts","description":"Comme Garde contre les Sorts I, mais peut empêcher jusqu’à vingt sorts différents."},"en":{"name":"Lord Spell Ward","description":"As Spell Ward I, but may prevent up to twenty different spells."}}}]},"_id":"ZNwGD1UTTI1fbXeE"}
{"name":"Weaponsmith","type":"spell-list","img":"icons/magic/symbols/rune-sigil-horned-white-purple.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"razak-zinul-weaponsmith","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS/MERP","sourceBook":"MERP Character Creation Using RMSS/RMFRP v2.5","sourceList":"Weaponsmith","sourcePage":235,"merpRealm":"Channeling","merpCategory":"Profession","profession":"Razak-zinul","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"merp-rmss-spell-list-conversion","reference":"MERP/RMSS v2.5 pp. 235; Razak-zinul Base List"},"compendiumSourceKey":"razak-zinul-weaponsmith","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-channeling-razak-zinul","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Forgeron d'Armes","system":{"name":"Forgeron d'Armes","label":"Forgeron d'Armes","notesLabel":"Forgeron d'Armes — notes","notes":"<h2>Forgeron d'Armes</h2><p>Liste du forgeron d’armes : accélération du combat, armes appelées à la main, parades spéciales et enchantements progressifs des armes.</p>"}},"en":{"name":"Weaponsmith","system":{"name":"Weaponsmith","label":"Weaponsmith","notesLabel":"Weaponsmith — notes","notes":"<h2>Weaponsmith</h2><p>Weaponsmithing List: accelerated combat, weapons called to hand, special parries, and progressive weapon enchantments.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Théurgie","Razak-Zinul (Base)"],"en":["Channeling Spell Lists","Razak-Zinul (Base)"]},"compendiumFolderKeyPath":["spell-lists-channeling","spell-lists-channeling-razak-zinul"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / MERP-RMSS v2.5","name":"Weaponsmith","listType":"Base","realms":"Channeling","profession":"Razak-zinul","notes":"<h2>Weaponsmith</h2><p>Weaponsmithing List: accelerated combat, weapons called to hand, special parries, and progressive weapon enchantments.</p>","label":"Weaponsmith","notesLabel":"Weaponsmith — notes","spells":[{"spellList":"Weaponsmith","listType":"Base","profession":"Razak-zinul","name":"Lightning Strike","label":"MERP_RMU.RazakZinul.weaponsmith.spells.LightningStrike.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.LightningStrike.description","level":1,"description":"Allows the caster to make an attack in the current Snap Action phase without the usual -20 penalty; the attack is part of the spell.","aoe":"caster","duration":"1 rnd","range":"self","spellType":"U","localizations":{"fr":{"name":"Frappe Éclair","description":"Permet au lanceur d’effectuer une attaque pendant la phase d’Action Instantanée en cours sans subir la pénalité habituelle de −20 ; l’attaque fait partie du sort."},"en":{"name":"Lightning Strike","description":"Allows the caster to make an attack in the current Snap Action phase without the usual -20 penalty; the attack is part of the spell."}}},{"spellList":"Weaponsmith","listType":"Base","profession":"Razak-zinul","name":"Attack I","label":"MERP_RMU.RazakZinul.weaponsmith.spells.AttackI.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.AttackI.description","level":2,"description":"Adds +15 to the caster’s melee or missile attack for the current round.","aoe":"caster","duration":"1 attack","range":"self","spellType":"U","localizations":{"fr":{"name":"Attaque I","description":"Ajoute +15 à l’attaque de mêlée ou de projectile du lanceur pour le round en cours."},"en":{"name":"Attack I","description":"Adds +15 to the caster’s melee or missile attack for the current round."}}},{"spellList":"Weaponsmith","listType":"Base","profession":"Razak-zinul","name":"Draw Weapon","label":"MERP_RMU.RazakZinul.weaponsmith.spells.DrawWeapon.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.DrawWeapon.description","level":3,"description":"The caster’s weapon leaps into the caster’s hand, negating normal penalties for drawing it.","aoe":"1 weapon","duration":"--","range":"self","spellType":"U","localizations":{"fr":{"name":"Dégainer l’Arme","description":"L’arme du lanceur bondit dans sa main, annulant les pénalités normales liées au fait de la dégainer."},"en":{"name":"Draw Weapon","description":"The caster’s weapon leaps into the caster’s hand, negating normal penalties for drawing it."}}},{"spellList":"Weaponsmith","listType":"Base","profession":"Razak-zinul","name":"Weapon I","label":"MERP_RMU.RazakZinul.weaponsmith.spells.WeaponI.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.WeaponI.description","level":4,"description":"Enchants a weapon with a +5 general magical bonus or +10 against one broad group.","aoe":"self","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Arme I","description":"Enchante une arme en lui conférant un bonus magique général de +5 ou +10 contre un vaste groupe de créatures."},"en":{"name":"Weapon I","description":"Enchants a weapon with a +5 general magical bonus or +10 against one broad group."}}},{"spellList":"Weaponsmith","listType":"Base","profession":"Razak-zinul","name":"Split Parry II","label":"MERP_RMU.RazakZinul.weaponsmith.spells.SplitParryII.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.SplitParryII.description","level":5,"description":"Caster may divide parry between up to two melee attackers without the normal split penalty.","aoe":"caster","duration":"1 rnd","range":"self","spellType":"U","localizations":{"fr":{"name":"Parade Répartie II","description":"Le lanceur peut répartir sa parade entre deux attaquants de mêlée au maximum sans subir la pénalité normale de répartition."},"en":{"name":"Split Parry II","description":"Caster may divide parry between up to two melee attackers without the normal split penalty."}}},{"spellList":"Weaponsmith","listType":"Base","profession":"Razak-zinul","name":"Summon Weapon","label":"MERP_RMU.RazakZinul.weaponsmith.spells.SummonWeapon.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.SummonWeapon.description","level":6,"description":"Summons one weapon within range to the caster’s hand.","aoe":"1 weapon","duration":"--","range":"50'","spellType":"U","localizations":{"fr":{"name":"Appel de l’Arme","description":"Appelle dans la main du lanceur une arme située à portée."},"en":{"name":"Summon Weapon","description":"Summons one weapon within range to the caster’s hand."}}},{"spellList":"Weaponsmith","listType":"Base","profession":"Razak-zinul","name":"Attack III","label":"MERP_RMU.RazakZinul.weaponsmith.spells.AttackIII.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.AttackIII.description","level":7,"description":"Improves the caster’s attack bonus according to the progression of Attack spells on this list.","aoe":"caster","duration":"1 attack","range":"self","spellType":"U","localizations":{"fr":{"name":"Attaque III","description":"Améliore le bonus d’attaque du lanceur selon la progression des sorts d’Attaque de cette liste."},"en":{"name":"Attack III","description":"Improves the caster’s attack bonus according to the progression of Attack spells on this list."}}},{"spellList":"Weaponsmith","listType":"Base","profession":"Razak-zinul","name":"Weapon II","label":"MERP_RMU.RazakZinul.weaponsmith.spells.WeaponII.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.WeaponII.description","level":8,"description":"As Weapon I, with a greater enchantment bonus.","aoe":"self","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Arme II","description":"Comme Arme I, mais avec un bonus d’enchantement supérieur."},"en":{"name":"Weapon II","description":"As Weapon I, with a greater enchantment bonus."}}},{"spellList":"Weaponsmith","listType":"Base","profession":"Razak-zinul","name":"Split Attack II","label":"MERP_RMU.RazakZinul.weaponsmith.spells.SplitAttackII.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.Spli