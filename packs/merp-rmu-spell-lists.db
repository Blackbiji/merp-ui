us."}}},{"spellList":"Attack Mastery","listType":"Base","profession":"Herutano","name":"Spell Parry","label":"MERP_RMU.RazakZinul.weaponsmith.spells.SpellParry.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.SpellParry.description","level":30,"description":"Allows one weapon to parry a spell attack as specified by the source rules.","aoe":"1 weapon","duration":"1 parry","range":"self","spellType":"F","localizations":{"fr":{"name":"Parade de Sort","description":"Permet d’utiliser une arme pour parer une attaque de sort selon les modalités précisées par les règles d’origine."},"en":{"name":"Spell Parry","description":"Allows one weapon to parry a spell attack as specified by the source rules."}}},{"spellList":"Attack Mastery","listType":"Base","profession":"Herutano","name":"Weapon V","label":"MERP_RMU.RazakZinul.weaponsmith.spells.WeaponV.name","descriptionLabel":"MERP_RMU.RazakZinul.weaponsmith.spells.WeaponV.description","level":50,"description":"The highest weapon enchantment on this list.","aoe":"self","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Arme V","description":"L’enchantement d’arme le plus puissant de cette liste."},"en":{"name":"Weapon V","description":"The highest weapon enchantment on this list."}}}]},"_id":"z4YY9FhCX2F4jznS"}
{"name":"Defense Mastery","type":"spell-list","img":"icons/magic/symbols/circled-gem-pink.webp","effects":[],"ownership":{"default":0},"flags":{"merp-ui":{"key":"herutano-defense-mastery","collection":"merp-rmu","contentVersion":1,"sourceSystem":"RMSS/MERP","sourceBook":"MERP Character Creation Using RMSS/RMFRP v2.5","sourceList":"Armourer","sourcePage":234,"merpRealm":"Channeling","merpCategory":"Profession","profession":"Razak-zinul","sorcery":false,"nativeRMU":false,"merpVariant":false,"source":{"type":"merp-rmu-adapted-spell-list","reference":"Armourer -> Defense Mastery","merpMapping":"Armourer mechanics adapted to MERP Herutano Defense Mastery"},"compendiumSourceKey":"herutano-defense-mastery","compendiumPack":"merp-rmu-spell-lists","compendiumSourceFile":"data/merp-rmu/non-rmu-spell-lists.json","compendiumFolderKey":"spell-lists-mentalism-herutano","compendiumBuildLanguage":"en","compendiumLocalizations":{"fr":{"name":"Maîtrise de la Défense","system":{"name":"Maîtrise de la Défense","label":"Maîtrise de la Défense","notesLabel":"Maîtrise de la Défense — notes","notes":"<h2>Maîtrise de la Défense</h2><p>Liste de forge défensive du Razak-Zinul : boucliers de force, renforcement des défenses et enchantement d’armures et de vêtements protecteurs.</p>"}},"en":{"name":"Defense Mastery","system":{"name":"Defense Mastery","label":"Defense Mastery","notesLabel":"Defense Mastery — notes","notes":"<h2>Defense Mastery</h2><p>Herutano defensive mastery List, centered on protection, defensive reactions, and the controlled reinforcement of martial defenses.</p>"}}},"compendiumAgeVariants":null,"compendiumFolderPath":{"fr":["Listes de Sorts de Mentalisme","Herutano (Base)"],"en":["Mentalism Spell Lists","Herutano (Base)"]},"compendiumFolderKeyPath":["spell-lists-mentalism","spell-lists-mentalism-herutano"],"compendiumResolverBacked":false}},"system":{"book":"MERP-RMU / MERP-RMSS v2.5","name":"Defense Mastery","listType":"Base","realms":"Mentalism","profession":"Herutano","notes":"<h2>Defense Mastery</h2><p>Herutano defensive mastery List, centered on protection, defensive reactions, and the controlled reinforcement of martial defenses.</p>","label":"Defense Mastery","notesLabel":"Defense Mastery — notes","spells":[{"spellList":"Defense Mastery","listType":"Base","profession":"Herutano","name":"Shield","label":"MERP_RMU.RazakZinul.armourer.spells.Shield.name","descriptionLabel":"MERP_RMU.RazakZinul.armourer.spells.Shield.description","level":2,"description":"Creates an invisible force shield in front of the caster. It functions like a normal shield but occupies no hand and cannot be combined with a real shield.","aoe":"caster","duration":"1 min/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Bouclier","description":"Crée devant le lanceur un bouclier de force invisible. Il fonctionne comme un bouclier normal, mais n’occupe aucune main et ne peut pas être combiné avec un bouclier réel."},"en":{"name":"Shield","description":"Creates an invisible force shield in front of the caster. It functions like a normal shield but occupies no hand and cannot be combined with a real shield."}}},{"spellList":"Defense Mastery","listType":"Base","profession":"Herutano","name":"Shield Defense I","label":"MERP_RMU.RazakZinul.armourer.spells.ShieldDefenseI.name","descriptionLabel":"MERP_RMU.RazakZinul.armourer.spells.ShieldDefenseI.description","level":3,"description":"Improves the caster’s shield DB by +5.","aoe":"caster","duration":"1 min/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Défense au Bouclier I","description":"Améliore de +5 la BD de bouclier du lanceur."},"en":{"name":"Shield Defense I","description":"Improves the caster’s shield DB by +5."}}},{"spellList":"Defense Mastery","listType":"Base","profession":"Herutano","name":"Armour Defense I","label":"MERP_RMU.RazakZinul.armourer.spells.ArmourDefenseI.name","descriptionLabel":"MERP_RMU.RazakZinul.armourer.spells.ArmourDefenseI.description","level":4,"description":"Improves the caster’s armour DB by +5.","aoe":"caster","duration":"1 min/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Défense d’Armure I","description":"Améliore de +5 la BD d’armure du lanceur."},"en":{"name":"Armour Defense I","description":"Improves the caster’s armour DB by +5."}}},{"spellList":"Defense Mastery","listType":"Base","profession":"Herutano","name":"Armour I","label":"MERP_RMU.RazakZinul.armourer.spells.ArmourI.name","descriptionLabel":"MERP_RMU.RazakZinul.armourer.spells.ArmourI.description","level":5,"description":"Enchants armour or a shield with a +5 general magical bonus or a +10 bonus against one broad group.","aoe":"self","duration":"24 hrs","range":"self","spellType":"F","localizations":{"fr":{"name":"Armure I","description":"Enchante une armure ou un bouclier en lui conférant un bonus magique général de +5 ou +10 contre un vaste groupe de créatures."},"en":{"name":"Armour I","description":"Enchants armour or a shield with a +5 general magical bonus or a +10 bonus against one broad group."}}},{"spellList":"Defense Mastery","listType":"Base","profession":"Herutano","name":"Enchant Cloth I","label":"MERP_RMU.RazakZinul.armourer.spells.EnchantClothI.name","descriptionLabel":"MERP_RMU.RazakZinul.armourer.spells.EnchantClothI.description","level":6,"description":"Enchants the caster’s clothing to protect as a heavier armour type according to the source list.","aoe":"caster","duration":"1 min/lvl","range":"self","spellType":"U","localizations":{"fr":{"name":"Enchantement du Tissu I","description":"Enchante les vêtements du lanceur afin qu’ils protègent comme un type d’armure plus lourd, conformément à la liste d’origine."},"en":{"name":"Enchant Cloth I","description":"Enchants the caster’s clothing to protect as a heavier armour type according to the source list."}}},{"spellList":"Defense Mastery","listType":"Base","profession":"Herutano","name":"Shield Defense II","label":"MERP_RMU.RazakZinul.armourer.spells.ShieldD